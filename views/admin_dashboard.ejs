<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap');
  :root {
    /* Mapped to the site-wide theme tokens (public/css/style.css) so this
       page follows the light/dark toggle instead of staying hard-coded dark. */
    --surface: var(--surface-card);
    --surface2: var(--ink-100);
    --border: var(--surface-border);
    --accent: #f0a500;
    --accent2: #ff5e5b;
    --accent3: #00d4aa;
    --text: var(--ink-900);
    --muted: var(--ink-500);
    --radius: 14px;
  }

  body { font-family: 'Arimo', sans-serif; }

  .adm-wrap { padding: 0 0 60px; }

  .page-header {
    padding: 28px 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .page-header h1 {
    font-family: 'Arimo', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.5px;
  }
  .page-header h1 span { color: var(--accent); }
  .page-header .subtitle { color: var(--muted); font-size: 0.85rem; margin-top: 2px; }

  .stat-strip {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .stat-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 22px;
    flex: 1;
    min-width: 130px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, border-color .2s;
  }
  .stat-chip:hover { transform: translateY(-2px); border-color: var(--accent); }
  .stat-chip::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }
  .stat-chip.c-yellow::before { background: var(--accent); }
  .stat-chip.c-red::before { background: var(--accent2); }
  .stat-chip.c-green::before { background: var(--accent3); }
  .stat-chip.c-blue::before { background: #4f8ef7; }
  .stat-chip .chip-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); font-weight: 600; }
  .stat-chip .chip-val {
    font-family: 'Arimo', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
    margin-top: 6px;
    color: var(--text);
  }

  /* ── Card ── */
  .adm-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .adm-card-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .adm-card-header h6 {
    font-family: 'Arimo', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .adm-card-header h6 .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .adm-card-body { padding: 20px; }

  /* ── Search Bar ── */
  .search-bar {
    display: flex;
    gap: 10px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 6px 6px 6px 16px;
    align-items: center;
  }
  .search-bar input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'Arimo', sans-serif;
    font-size: 0.9rem;
    flex: 1;
    min-width: 0;
  }
  .search-bar input::placeholder { color: var(--muted); }
  .btn-accent {
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 7px 16px;
    cursor: pointer;
    transition: opacity .15s;
    white-space: nowrap;
  }
  .btn-accent:hover { opacity: 0.85; }
  .btn-ghost {
    background: var(--surface2);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.82rem;
    padding: 7px 14px;
    cursor: pointer;
    transition: border-color .15s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn-ghost.danger:hover { border-color: var(--accent2); color: var(--accent2); }

  .vtp-status {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }
  .vtp-status .indicator {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .vtp-status.ok .indicator { background: var(--accent3); box-shadow: 0 0 8px var(--accent3); }
  .vtp-status.warn .indicator { background: #f0a500; box-shadow: 0 0 8px #f0a500; }
  .vtp-status .info { color: var(--muted); font-size: 0.75rem; }

  .adm-input {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    padding: 8px 12px;
    width: 100%;
    outline: none;
    transition: border-color .15s;
  }
  .adm-input:focus { border-color: var(--accent); }
  .adm-input::placeholder { color: var(--muted); }
  .adm-label { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; font-weight: 600; margin-bottom: 6px; display: block; }

  .adm-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .adm-table thead tr { border-bottom: 1px solid var(--border); }
  .adm-table thead th {
    padding: 10px 14px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  .adm-table tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background .15s;
  }
  .adm-table tbody tr:hover { background: var(--surface2); }
  .adm-table tbody tr.locked { opacity: 0.5; }
  .adm-table td { padding: 12px 14px; vertical-align: middle; }

  .user-avatar {
    width: 32px; height: 32px;
    border-radius: 8px;
    object-fit: cover;
    margin-right: 10px;
    border: 1.5px solid var(--border);
  }
  .user-name { font-weight: 500; color: var(--text); font-size: 0.9rem; }
  .user-sub { color: var(--muted); font-size: 0.75rem; }

  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 20px;
  }
  .badge-status.active { background: rgba(0,212,170,.12); color: var(--accent3); }
  .badge-status.locked { background: rgba(255,94,91,.12); color: var(--accent2); }

  .price-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .price-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .price-row label { color: var(--muted); font-size: 0.7rem; width: 34px; flex-shrink: 0; }
  .price-input {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.8rem;
    padding: 4px 8px;
    width: 90px;
    outline: none;
  }
  .price-input:focus { border-color: var(--accent); }
  .btn-save-price {
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 10px;
    cursor: pointer;
    margin-top: 4px;
    width: 100%;
    transition: opacity .15s;
  }
  .btn-save-price:hover { opacity: 0.85; }

  select.adm-select {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.8rem;
    padding: 6px 10px;
    outline: none;
    width: 100%;
  }

  .log-item { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .log-item:last-child { border: none; }
  .log-actor {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 0.72rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .log-text { font-size: 0.82rem; color: var(--text); line-height: 1.4; }
  .log-time { font-size: 0.7rem; color: var(--muted); margin-top: 2px; }

  .today-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .today-row:last-child { border: none; }
  .today-shop { flex: 1; min-width: 0; }
  .today-shop .name { font-weight: 500; font-size: 0.88rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .today-shop .handle { font-size: 0.72rem; color: var(--muted); }
  .today-orders {
    background: rgba(240,165,0,.12);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .today-cod { font-family: 'Arimo', sans-serif; font-size: 0.88rem; font-weight: 700; color: var(--accent3); white-space: nowrap; }

  #bill-result-area { margin-top: 16px; }
  .bill-table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
  .bill-table th { padding: 8px 12px; color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.6px; border-bottom: 1px solid var(--border); }
  .bill-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .toolbar-search {
    flex: 1; min-width: 160px;
    display: flex;
    gap: 8px;
  }

  .modal-content { background: var(--surface) !important; border: 1px solid var(--border) !important; border-radius: var(--radius) !important; color: var(--text) !important; }
  .modal-header { background: var(--surface2) !important; border-bottom: 1px solid var(--border) !important; }
  .modal-header .modal-title { font-family: 'Arimo', sans-serif; font-weight: 700; color: var(--text) !important; font-size: 1rem; }
  .modal-footer { background: var(--surface2) !important; border-top: 1px solid var(--border) !important; }
  [data-bs-theme="dark"] .modal-header .btn-close { filter: invert(1); }
  .form-label { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  .form-control, .form-select {
    background: var(--surface2) !important;
    border: 1px solid var(--border) !important;
    color: var(--text) !important;
    border-radius: 8px !important;
    font-size: 0.87rem !important;
  }
  .form-control:focus, .form-select:focus { border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(240,165,0,.1) !important; }
  .btn-secondary { background: var(--surface2) !important; border: 1px solid var(--border) !important; color: var(--text) !important; }
  .btn-success { background: var(--accent3) !important; border-color: var(--accent3) !important; color: #000 !important; font-weight: 700 !important; }
  .btn-success:hover { opacity: 0.85 !important; }

  .custom-popup-overlay .bg-white {
    background: var(--surface) !important;
    color: var(--text) !important;
    border: 1px solid var(--border) !important;
  }
  .custom-popup-overlay h5 { font-family: 'Arimo', sans-serif; font-weight: 700; font-size: 1rem; color: var(--text); }

  #modal-edit-order .modal-content { background: var(--surface) !important; }
  #modal-edit-order h5 { font-family: 'Arimo', sans-serif; font-weight: 700; color: var(--text); }
  #modal-edit-order label { color: var(--muted); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  #modal-edit-order .form-control, #modal-edit-order .form-select, #modal-edit-order textarea {
    background: var(--surface2) !important;
    border: 1px solid var(--border) !important;
    color: var(--text) !important;
    border-radius: 8px !important;
  }

  #admin-jt-modal .bg-white { background: var(--surface) !important; }
  #admin-jt-modal label { color: var(--muted); font-size: 0.76rem; text-transform: uppercase; font-weight: 600; }
  #admin-jt-modal .form-control, #admin-jt-modal .form-select {
    background: var(--surface2) !important;
    border: 1px solid var(--border) !important;
    color: var(--text) !important;
    border-radius: 8px !important;
  }
  #admin-jt-modal .btn-light { background: var(--surface2) !important; border: 1px solid var(--border) !important; color: var(--text) !important; }
  #admin-jt-modal .btn-primary { background: var(--accent) !important; border-color: var(--accent) !important; color: #000 !important; font-weight: 700 !important; }

  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: var(--surface); }
  ::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 4px; }

  /* ── Toggle switch (khóa đăng ký, v.v.) ── */
  .reg-lock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 0;
  }
  .reg-lock-row .lbl { font-weight: 600; color: var(--text); font-size: 0.88rem; }
  .reg-lock-row .sub { color: var(--muted); font-size: 0.75rem; margin-top: 2px; }
  .adm-switch { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
  .adm-switch input { opacity: 0; width: 0; height: 0; }
  .adm-switch .slider {
    position: absolute; cursor: pointer; inset: 0;
    background: var(--surface2);
    border: 1px solid var(--border);
    transition: .2s;
    border-radius: 999px;
  }
  .adm-switch .slider::before {
    position: absolute; content: "";
    height: 18px; width: 18px;
    left: 3px; bottom: 3px;
    background: var(--muted);
    transition: .2s;
    border-radius: 50%;
  }
  .adm-switch input:checked + .slider { background: rgba(255,94,91,0.18); border-color: var(--accent2); }
  .adm-switch input:checked + .slider::before { transform: translateX(20px); background: var(--accent2); }
  .adm-switch input:disabled + .slider { opacity: .5; cursor: not-allowed; }
</style>

<div class="container-fluid px-3 px-md-4 adm-wrap">

  <div class="page-header">
    <div>
      <h1>Admin <span>Dashboard</span></h1>
      <div class="subtitle">Quản lý hệ thống TV Ship</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn-ghost" onclick="openExportModal(null, null)">
        <i class="fas fa-file-excel"></i> Xuất Excel
      </button>
      <button class="btn-ghost" onclick="document.getElementById('excelInput').click()">
        <i class="fas fa-file-import"></i> Nhập khách
      </button>
    </div>
    <input type="file" id="excelInput" accept=".xlsx, .xls" style="display:none;" onchange="handleExcel(this)">
  </div>

  <% if (currentRole === 'admin' && !admin2FAEnabled) { %>
  <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" style="border-radius:12px;">
    <i class="fas fa-shield-halved"></i>
    <div class="flex-grow-1">
      Bạn chưa bật <strong>Xác thực 2 lớp (2FA)</strong>. Mọi thao tác sửa thông tin người dùng (giá cước, kho J&T, khóa/mở khóa,
      đổi quyền, xóa), khóa/mở đăng ký tài khoản mới và cập nhật token Viettel Post sẽ bị chặn cho tới khi bạn bật 2FA.
    </div>
    <a href="/profile" class="btn btn-sm btn-warning text-nowrap">Bật 2FA ngay</a>
  </div>
  <% } %>

  <div class="row g-4">

    <!-- ── LEFT COLUMN ── -->
    <div class="col-lg-4">

      <!-- VTP Config -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:var(--accent2)"></span> Viettel Post</h6>
        </div>
        <div class="adm-card-body">
          <div id="vtp-status" class="vtp-status <%= vtpConfig && vtpConfig.vtp_token ? 'ok' : 'warn' %>">
            <span class="indicator"></span>
            <div>
              <% if (vtpConfig && vtpConfig.vtp_token) { %>
                <div style="font-weight:600;color:var(--accent3);">Đang hoạt động</div>
                <div class="info">CusID: <%= vtpConfig.vtp_cusid %> &nbsp;·&nbsp; <%= vtpConfig.vtp_username %></div>
              <% } else { %>
                <div style="font-weight:600;color:var(--accent);">Chưa cấu hình</div>
                <div class="info">Nhập thông tin để kết nối</div>
              <% } %>
            </div>
          </div>
          <button onclick="openVtpModal()" class="btn-accent w-100">
            <i class="fas fa-key me-1"></i> Cập nhật token hệ thống
          </button>
        </div>
      </div>

      <!-- Khóa đăng ký tài khoản mới -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:var(--accent2)"></span> Đăng ký tài khoản</h6>
        </div>
        <div class="adm-card-body">
          <div class="reg-lock-row">
            <div>
              <div class="lbl">Khóa đăng ký mới</div>
              <div class="sub">Khi bật, người dùng không thể tạo tài khoản mới tại /register</div>
            </div>
            <label class="adm-switch">
              <input type="checkbox" id="registrationLockSwitch"
                     <%= registrationLocked ? 'checked' : '' %>
                     <%= currentRole === 'admin' ? '' : 'disabled' %>
                     onchange="toggleRegistrationLock(this)">
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- Today Orders -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:var(--accent3)"></span> Đơn hàng hôm nay</h6>
          <span style="font-size:0.72rem;color:var(--muted);">Theo giờ tạo</span>
        </div>
        <div class="adm-card-body" style="padding:16px 20px;">
          <% if (todayStats && todayStats.length > 0) { %>
            <% todayStats.forEach(item => { %>
            <div class="today-row">
              <div class="today-shop">
                <div class="name"><%= item.shopname || 'Chưa đặt tên' %></div>
                <div class="handle">@<%= item.username %></div>
              </div>
              <span class="today-orders"><%= item.total_orders %> đơn</span>
              <span class="today-cod"><%= new Intl.NumberFormat('vi-VN').format(item.total_cod || 0) %>đ</span>
            </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center;padding:32px 0;color:var(--muted);">
              <i class="fas fa-box-open fa-2x mb-2" style="opacity:.3;display:block;"></i>
              Hôm nay chưa có đơn hàng
            </div>
          <% } %>
        </div>
      </div>

      <!-- Activity Log -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:#4f8ef7"></span> Nhật ký hoạt động</h6>
        </div>
        <div class="adm-card-body" style="max-height:320px;overflow-y:auto;">
          <% logs.forEach(log => { %>
          <div class="log-item">
            <div class="log-actor"><i class="fas fa-user-circle" style="font-size:0.65rem;"></i> <%= log.performed_by %></div>
            <div class="log-text"><%= log.action %></div>
            <div class="log-time"><%= new Date(log.created_at).toLocaleString('vi-VN') %></div>
          </div>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- ── RIGHT COLUMN ── -->
    <div class="col-lg-8">

      <!-- Bill Search -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:var(--accent)"></span> Tra cứu & Chỉnh sửa vận đơn</h6>
        </div>
        <div class="adm-card-body">
          <div class="search-bar">
            <i class="fas fa-search" style="color:var(--muted);"></i>
            <input type="text" id="search-bill-code" placeholder="Nhập mã vận đơn (J&T, Viettel, GHN...)">
            <button class="btn-accent" onclick="searchBillAdmin()">Tìm kiếm</button>
          </div>
          <div id="bill-result-area" style="display:none;margin-top:16px;overflow-x:auto;">
            <table class="bill-table">
              <thead>
                <tr>
                  <th>UID</th><th>Mã đơn</th><th>Người nhận</th><th>SĐT</th><th>Trạng thái</th><th></th>
                </tr>
              </thead>
              <tbody id="bill-result-body"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- User Management -->
      <div class="adm-card">
        <div class="adm-card-header">
          <h6><span class="dot" style="background:var(--accent3)"></span> Quản lý người dùng</h6>
          <form action="/admin/dashboard" method="GET" style="display:flex;gap:8px;">
