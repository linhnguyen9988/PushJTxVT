<script>
  const CURRENT_ROLE = "<%= currentRole %>";
  const ADMIN_2FA_ENABLED = <%- admin2FAEnabled ? 'true' : 'false' %>;

  // ═══ Modal xác nhận 2FA dùng chung cho các thao tác sửa thông tin user ═══
  let _pending2FAResolve = null;
  function open2FAModal() {
    return new Promise((resolve) => {
      _pending2FAResolve = resolve;
      const input = document.getElementById('admin2fa-code');
      input.value = '';
      document.getElementById('admin-2fa-modal').style.display = 'flex';
      setTimeout(() => input.focus(), 50);
    });
  }
  function confirm2FAModal() {
    const code = document.getElementById('admin2fa-code').value.trim();
    if (!code || code.length < 6) { showNotice('Cảnh báo', 'Nhập đủ mã 6 số từ app Authenticator!', 'warning'); return; }
    document.getElementById('admin-2fa-modal').style.display = 'none';
    if (_pending2FAResolve) { const r = _pending2FAResolve; _pending2FAResolve = null; r(code); }
  }
  function cancel2FAModal() {
    document.getElementById('admin-2fa-modal').style.display = 'none';
    if (_pending2FAResolve) { const r = _pending2FAResolve; _pending2FAResolve = null; r(null); }
  }

  // Yêu cầu mã 2FA rồi submit 1 form (dùng cho Khóa/Mở khóa, Xóa user)
  async function submitWith2FA(formId, hiddenFieldId) {
    if (CURRENT_ROLE === 'admin' && !ADMIN_2FA_ENABLED) {
      showNotice('Cần bật 2FA', 'Bạn cần bật Xác thực 2 lớp (2FA) trong Trang cá nhân trước khi thực hiện thao tác này trên tài khoản người dùng.', 'warning');
      return;
    }
    const code = await open2FAModal();
    if (!code) return;
    document.getElementById(hiddenFieldId).value = code;
    document.getElementById(formId).submit();
  }

  async function toggleRegistrationLock(checkbox) {
    const prevState = !checkbox.checked; // trạng thái trước khi bấm

    if (!ADMIN_2FA_ENABLED) {
      checkbox.checked = prevState;
      showNotice('Cần bật 2FA', 'Bạn cần bật Xác thực 2 lớp (2FA) trong Trang cá nhân trước khi khóa/mở đăng ký tài khoản.', 'warning');
      return;
    }
    const totpCode = await open2FAModal();
    if (!totpCode) { checkbox.checked = prevState; return; }

    checkbox.disabled = true;
    try {
      const res = await fetch('/admin/toggle-registration-lock', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ totpCode })
      });
      const result = await res.json();
      if (result.success) {
        checkbox.checked = result.locked;
        showNotice("Thành công", result.locked ? "Đã khóa đăng ký tài khoản mới." : "Đã mở khóa đăng ký tài khoản mới.", "success");
      } else {
        checkbox.checked = prevState;
        showNotice("Lỗi", result.message || "Không thể cập nhật cài đặt.", "danger");
      }
    } catch (e) {
      checkbox.checked = prevState;
      showNotice("Lỗi", "Lỗi kết nối server.", "danger");
    } finally {
      checkbox.disabled = (CURRENT_ROLE !== 'admin');
    }
  }

  function openVtpModal() {
    document.getElementById('vtp-modal').style.display = 'flex';
  }
  function closeVtpModal() {
    document.getElementById('vtp-modal').style.display = 'none';
  }

  async function connectVTPAdmin() {
    const user = document.getElementById('vtp_user').value;
    const pass = document.getElementById('vtp_pass').value;
    if (!user || !pass) return showNotice("Cảnh báo", "Nhập đủ tài khoản admin Viettel Post!", "warning");

    if (!ADMIN_2FA_ENABLED) {
      showNotice('Cần bật 2FA', 'Bạn cần bật Xác thực 2 lớp (2FA) trong Trang cá nhân trước khi cập nhật token Viettel Post.', 'warning');
      return;
    }
    const totpCode = await open2FAModal();
    if (!totpCode) return;

    try {
      const res = await fetch('/admin/update-vtp-system', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vtp_user: user, vtp_pass: pass, totpCode })
      });
      const result = await res.json();
      if (result.success) { closeVtpModal(); alert("Đã cập nhật cấu hình Viettel Post!"); location.reload(); }
      else alert(result.message);
    } catch (e) { alert("Lỗi kết nối server"); }
  }

  async function updateUserPrice(userId) {
    const basePrice = document.querySelector(`.base-price[data-id="${userId}"]`).value;
    const stepPrice = document.querySelector(`.step-price[data-id="${userId}"]`).value;
    const baseWeight = document.querySelector(`.base-weight[data-id="${userId}"]`).value;
    if (!basePrice || !stepPrice || !baseWeight) { showNotice("Cảnh báo", "Nhập đầy đủ giá cước, kg!", "warning"); return; }

    if (!ADMIN_2FA_ENABLED) {
      showNotice('Cần bật 2FA', 'Bạn cần bật Xác thực 2 lớp (2FA) trong Trang cá nhân trước khi sửa thông tin người dùng.', 'warning');
      return;
    }
    const totpCode = await open2FAModal();
    if (!totpCode) return;

    try {
      const response = await fetch('/admin/update-user-price', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, basePrice, stepPrice, baseWeight, totpCode })
      });
      const result = await response.json();
      if (result.success) {
        const btn = document.querySelector(`button[onclick="updateUserPrice(${userId})"]`);
        const orig = btn.innerHTML;
        btn.style.background = 'var(--accent3)';
        btn.innerHTML = '<i class="fas fa-check"></i> Đã lưu';
        setTimeout(() => { btn.style.background = ''; btn.innerHTML = orig; }, 2000);
      } else { showNotice("Lỗi", result.message, "error"); }
    } catch (e) { showNotice("Lỗi", "Không kết nối được server", "error"); }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const res = await fetch('/api/viettel/inventories');
      const result = await res.json();
      if (result.status === 200) {
        document.querySelectorAll('.vtp-shop-select').forEach(select => {
          const cur = select.getAttribute('data-current-id');
          result.data.forEach(shop => {
            const opt = document.createElement('option');
            opt.value = shop.id;
            opt.text = `${shop.name} (${shop.phone})`;
            opt.dataset.name = shop.name; opt.dataset.phone = shop.phone; opt.dataset.address = shop.address;
            if (cur && String(shop.id).trim() === String(cur).trim()) opt.selected = true;
            select.appendChild(opt);
          });
        });
      }
    } catch (e) { console.error("Lỗi nạp kho:", e); }
  });

  async function handleShopChange(selectEl) {
    const userId = selectEl.getAttribute('data-user-id');
    const opt = selectEl.options[selectEl.selectedIndex];
    if (!opt.value) return;
    try {
      const res = await fetch('/admin/assign-vtp-shop', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, shopData: { inventoryId: opt.value, name: opt.dataset.name, phone: opt.dataset.phone, address: opt.dataset.address } })
      });
      const result = await res.json();
      if (result.success) showNotice("Thành công", "Đã gán kho!", "success");
      else showNotice("Lỗi", result.message, "error");
    } catch (e) { showNotice("Lỗi", "Lỗi kết nối!", "error"); }
  }

  let excelData = [];
  function handleExcel(input) {
    const file = input.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = function (e) {
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, { type: 'array' });
      const sheet = workbook.Sheets[workbook.SheetNames[0]];
      const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });
      const previewBody = document.getElementById('previewBody');
      previewBody.innerHTML = ''; excelData = [];
      jsonData.slice(1).forEach(row => {
        if (row.length >= 2 && row[1]) {
          const c = { name: String(row[0]||'').trim(), phone: String(row[1]||'').trim(), address: String(row[2]||'').trim() };
          if (c.name && c.phone && c.phone.toLowerCase() !== 'sđt') {
            excelData.push(c);
            previewBody.innerHTML += `<tr><td style="padding:8px 12px;">${c.name}</td><td style="padding:8px 12px;color:var(--accent3);font-weight:600;">${c.phone}</td><td style="padding:8px 12px;color:var(--muted);font-size:.8rem;">${c.address}</td></tr>`;
          }
        }
      });
      if (!excelData.length) { showNotice("Lỗi","Không có dữ liệu hợp lệ!","error"); return; }
      document.getElementById('rowCountDesc').innerText = `Tổng: ${excelData.length} khách hàng`;
      new bootstrap.Modal(document.getElementById('previewModal')).show();
    };
    reader.readAsArrayBuffer(file); input.value = '';
  }

  async function uploadAll() {
    const targetUserId = document.getElementById('targetUserSelect').value;
    const btn = document.getElementById('btnUpload');
    if (!targetUserId) { showNotice("Cảnh báo","Chọn User nhận khách đi!","warning"); return; }
    if (!confirm(`Xác nhận nhập ${excelData.length} khách?`)) return;
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang lưu...';
    try {
      const response = await fetch('/admin/import-customers', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customers: excelData, targetUserId })
      });
      const result = await response.json();
      if (result.success) {
        let msg = `Đã thêm ${result.count} khách hàng.`;
        if (result.ignored > 0) msg += ` (bỏ qua ${result.ignored} đã có)`;
        showNotice("Thành công", msg, "success"); location.reload();
      } else { showNotice('Lỗi', result.message, "error"); btn.disabled = false; btn.innerHTML = 'Xác nhận thêm vào DB'; }
    } catch (err) { showNotice('Lỗi','Lỗi kết nối!','error'); btn.disabled = false; }
  }

  function openExportModal(userId) {
    const now = new Date();
    document.getElementById('exportStartDate').value = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
    document.getElementById('exportEndDate').value = now.toISOString().split('T')[0];
    if (userId) document.getElementById('exportShopSelect').value = userId;
    new bootstrap.Modal(document.getElementById('exportExcelModal')).show();
  }

  async function handleExportExcel() {
    const select = document.getElementById('exportShopSelect');
    const userId = select.value;
    const username = select.options[select.selectedIndex]?.dataset?.username || userId;
    const startDate = document.getElementById('exportStartDate').value;
    const endDate = document.getElementById('exportEndDate').value;
    const dateType = document.getElementById('exportDateType').value;
    if (!userId) return alert("Chọn shop cần xuất!");
    if (!startDate || !endDate) return alert("Chọn ngày!");
    try {
      const btn = document.querySelector('#exportExcelModal .btn-success');
      const orig = btn.innerHTML; btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tạo...';
      const res = await fetch(`/admin/export-orders?userId=${userId}&start=${startDate}&end=${endDate}&dateType=${dateType}`);
      if (!res.ok) throw new Error("Không có dữ liệu trong khoảng này!");
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url;
      a.download = `Van_Don_${username}_${startDate}_to_${endDate}.xlsx`;
      document.body.appendChild(a); a.click(); a.remove();
      btn.disabled = false; btn.innerHTML = orig;
      bootstrap.Modal.getInstance(document.getElementById('exportExcelModal')).hide();
    } catch (err) {
      alert(err.message);
      const btn = document.querySelector('#exportExcelModal .btn-success');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-download me-1"></i> Tải về (.xlsx)';
    }
  }

  function closeAdminJTModal() { document.getElementById('admin-jt-modal').style.display = 'none'; }

  async function openAdminJTModal(userData) {
    if (typeof userData === 'string') userData = JSON.parse(userData);
    document.getElementById('target-user-id').innerText = userData.id;
    document.getElementById('input-target-id').value = userData.id;
    const g = v => (v && v !== 'null' && v !== 'undefined') ? v : '';
    document.getElementById('adm_jt_name').value = g(userData.jt_shopname);
    document.getElementById('adm_jt_sdt').value = g(userData.jt_sdt);
    document.getElementById('adm_jt_addr').value = g(userData.jt_shopaddress);
    document.getElementById('adm_jt_dist').innerHTML = '<option>-- Chọn Huyện --</option>';
    document.getElementById('adm_jt_ward').innerHTML = '<option>-- Chọn Xã --</option>';
    document.getElementById('admin-jt-modal').style.display = 'flex';
    const p = g(userData.jt_shop_prov), d = g(userData.jt_shop_district), w = g(userData.jt_shop_ward);
    await loadProvincesAdmin(p);
    if (p) { await loadDistrictsAdmin(p, d); if (d) await loadWardsAdmin(p, d, w); }
  }

  async function loadProvincesAdmin(sel, targetId = 'adm_jt_prov') {
    const res = await fetch('/api/address/provinces');
    const provinces = await res.json();
    const select = document.getElementById(targetId);
    if (!select) return;
    select.innerHTML = '<option value="">-- Chọn Tỉnh --</option>';
    provinces.forEach(p => { select.innerHTML += `<option value="${p}" ${p===sel?'selected':''}>${p}</option>`; });
  }

  async function loadDistrictsAdmin(prov, sel, targetId = 'adm_jt_dist') {
    if (!prov) return;
    const res = await fetch(`/api/address/districts?prov=${encodeURIComponent(prov)}`);
    const districts = await res.json();
    const select = document.getElementById(targetId);
    if (!select) return;
    select.innerHTML = '<option value="">-- Chọn Huyện --</option>';
    districts.forEach(d => { select.innerHTML += `<option value="${d}" ${d===sel?'selected':''}>${d}</option>`; });
  }

  async function loadWardsAdmin(prov, dist, sel, targetId = 'adm_jt_ward') {
    if (!dist) return;
    const res = await fetch(`/api/address/wards?prov=${encodeURIComponent(prov)}&district=${encodeURIComponent(dist)}`);
    const wards = await res.json();
    const select = document.getElementById(targetId);
    if (!select) return;
    select.innerHTML = '<option value="">-- Chọn Xã --</option>';
    wards.forEach(w => { select.innerHTML += `<option value="${w}" ${w===sel?'selected':''}>${w}</option>`; });
  }

  async function submitAdminJT() {
    const form = document.getElementById('admin-jt-form');
    const data = Object.fromEntries(new FormData(form).entries());
    const required = { jt_shopname:"Tên Shop", jt_sdt:"Số điện thoại", jt_shopaddress:"Địa chỉ", jt_shop_prov:"Tỉnh", jt_shop_district:"Huyện", jt_shop_ward:"Xã" };
    for (const [k, label] of Object.entries(required)) {
      if (!data[k]?.trim()) { alert(`Nhập: ${label}`); form.querySelector(`[name="${k}"]`)?.focus(); return; }
    }

    if (!ADMIN_2FA_ENABLED) {
      showNotice('Cần bật 2FA', 'Bạn cần bật Xác thực 2 lớp (2FA) trong Trang cá nhân trước khi sửa thông tin người dùng.', 'warning');
      return;
    }
    const totpCode = await open2FAModal();
    if (!totpCode) return;
    data.totpCode = totpCode;

    try {
      const res = await fetch('/api/admin/update-user-jt', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
      const result = await res.json();
      if (result.success) { alert("Cập nhật kho J&T thành công!"); location.reload(); }
      else alert("Lỗi: " + result.message);
    } catch (e) { alert("Lỗi kết nối!"); }
  }

  let currentOrderData = null, searchResults = [];

  async function searchBillAdmin() {
    const code = document.getElementById('search-bill-code').value.trim();
    if (!code) return alert("Nhập mã đơn!");
    const res = await fetch(`/api/admin/get-order?code=${encodeURIComponent(code)}`);
    const data = await res.json();
    if (data.success) {
      searchResults = data.orders;
      document.getElementById('bill-result-area').style.display = 'block';
      document.getElementById('bill-result-body').innerHTML = data.orders.map((order, i) => `
        <tr>
          <td>${order.user_id}</td>
          <td style="font-family:'Arimo',sans-serif;font-size:.82rem;">${order.realjtbillcode || order.order_code}</td>
          <td>${order.customer_name}</td>
          <td>${order.customer_phone}</td>
          <td><span class="badge-status active">${order.status}</span></td>
          <td><button class="btn-ghost" onclick="prepareEditOrder(${i})"><i class="fas fa-edit"></i> Sửa</button></td>
        </tr>`).join('');
    }
  }

  function prepareEditOrder(i) { currentOrderData = searchResults[i]; if (currentOrderData) openEditOrderModal(); }

  async function openEditOrderModal() {
    if (!currentOrderData) return;
    document.getElementById('modal-edit-order').style.display = 'flex';
    ['edit-order-id','edit-cust-name','edit-cust-phone','edit-cust-addr','edit-cust-cod','edit-cust-kg','edit-cust-id'].forEach(id => {
      const map = { 'edit-order-id':'id','edit-cust-name':'customer_name','edit-cust-phone':'customer_phone','edit-cust-addr':'customer_address','edit-cust-cod':'price','edit-cust-kg':'weight','edit-cust-id':'user_id' };
      document.getElementById(id).value = currentOrderData[map[id]] || '';
    });
    await loadProvincesAdmin(currentOrderData.jt_prov, 'edit_jt_prov');
    await loadDistrictsAdmin(currentOrderData.jt_prov, currentOrderData.jt_district, 'edit_jt_dist');
    await loadWardsAdmin(currentOrderData.jt_prov, currentOrderData.jt_district, currentOrderData.jt_ward, 'edit_jt_ward');
  }

  async function saveOrderUpdate() {
    const f = id => document.getElementById(id).value;
    if (!f('edit-cust-name') || !f('edit-cust-phone')) return alert("Nhập đủ Tên và SĐT!");
    const data = {
      id: f('edit-order-id'), customer_name: f('edit-cust-name').trim(),
      customer_phone: f('edit-cust-phone').trim(), customer_address: f('edit-cust-addr').trim(),
      price: parseFloat(f('edit-cust-cod')) || 0, custId: f('edit-cust-id'),
      kg: f('edit-cust-kg') || 1, jt_prov: f('edit_jt_prov'),
      jt_district: f('edit_jt_dist'), jt_ward: f('edit_jt_ward')
    };
    try {
      const res = await fetch('/api/admin/update-order', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
      const result = await res.json();
      if (result.success) { alert("✅ Cập nhật thành công!"); document.getElementById('modal-edit-order').style.display = 'none'; location.reload(); }
      else alert("❌ Lỗi: " + result.message);
    } catch (e) { alert("Lỗi kết nối!"); }
  }
</script>

