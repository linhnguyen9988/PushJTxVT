                <th>Giá cước</th>
                <th>Trạng thái</th>
                <th>Kho VTP</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(row => { %>
              <tr class="<%= row.is_locked ? 'locked' : '' %>">
                <td>
                  <div style="display:flex;align-items:center;">
                    <img src="<%= row.avatar || '/default-avatar.png' %>" class="user-avatar" alt="">
                    <div>
                      <div class="user-name"><%= row.username %></div>
                      <div class="user-sub"><%= row.shopname || '—' %></div>
