<%- include('partials/header', { authArtwork: true }) %>

<main class="auth-scene" aria-label="Đăng nhập">
    <div class="auth-panel">
        <div class="card auth-panel-card">
            <span class="ui-page-kicker text-center mb-2">Trung tâm giao vận</span>
            <h3 class="text-center fw-bold mb-1">Đăng nhập</h3>
            <p class="text-center text-muted small mb-4">Chào mừng bạn quay lại TV Ship</p>

            <%- include('partials/messages') %>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="auth-username" class="form-label">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-user text-muted"></i></span>
                        <input id="auth-username" autocomplete="username" type="text" name="username" class="form-control border-start-0 ps-0" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="auth-password" class="form-label">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input id="auth-password" autocomplete="current-password" type="password" name="password" class="form-control border-start-0 ps-0" required>
                    </div>
                </div>
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input type="checkbox" name="rememberMe" class="form-check-input" id="rem">
                        <label class="form-check-label small" for="rem">Ghi nhớ đăng nhập</label>
                    </div>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#forgotModal" class="small text-decoration-none">Quên mật khẩu?</a>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Vào hệ thống</button>
            </form>

            <div class="text-center mt-4">
                <p class="mb-0 text-muted small">Chưa có tài khoản? <a href="/register" class="text-decoration-none fw-bold">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="forgotModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0">Quên mật khẩu?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-muted">Vui lòng liên hệ Admin để đặt lại mật khẩu của bạn.</div>
            <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button></div>
        </div>
    </div>
</div>



<%- include('partials/footer', { active: 'orders' }) %>
