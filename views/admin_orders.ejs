        <script>
            (function () {
                const tbody = document.getElementById('ordersTableBody');
                const bar = document.getElementById('ordersPagination');
                if (!tbody || !bar) return;

                const allRows = Array.from(tbody.querySelectorAll('tr')).filter(tr => !tr.querySelector('td[colspan]'));
                if (allRows.length === 0) { bar.style.display = 'none'; return; }

                const sizeSelect = document.getElementById('ordersPageSize');
                const pageInfo = document.getElementById('ordersPageInfo');
                const btnPrev = document.getElementById('ordersPagePrev');
                const btnNext = document.getElementById('ordersPageNext');

                let pageSize = localStorage.getItem('tvship-orders-pagesize') || '20';
                if (!['20', '50', '100', 'all'].includes(pageSize)) pageSize = '20';
                sizeSelect.value = pageSize;
                pageSize = pageSize === 'all' ? Number.MAX_SAFE_INTEGER : parseInt(pageSize, 10);
                let currentPage = 1;

                function render() {
                    const totalPages = Math.max(1, Math.ceil(allRows.length / pageSize));
                    if (currentPage > totalPages) currentPage = totalPages;
                    const start = (currentPage - 1) * pageSize;
                    const end = start + pageSize;

                    allRows.forEach((tr, idx) => {
                        tr.style.display = (idx >= start && idx < end) ? '' : 'none';
                    });

                    pageInfo.textContent = `Trang ${currentPage}/${totalPages} (${allRows.length} đơn)`;
                    btnPrev.disabled = currentPage <= 1;
                    btnNext.disabled = currentPage >= totalPages;
                    bar.style.display = allRows.length > 0 ? 'flex' : 'none';
                }

                sizeSelect.addEventListener('change', function () {
                    localStorage.setItem('tvship-orders-pagesize', this.value);
                    pageSize = this.value === 'all' ? Number.MAX_SAFE_INTEGER : parseInt(this.value, 10);
                    currentPage = 1;
                    render();
                });
                btnPrev.addEventListener('click', function () { if (currentPage > 1) { currentPage--; render(); } });
                btnNext.addEventListener('click', function () {
                    const totalPages = Math.max(1, Math.ceil(allRows.length / pageSize));
                    if (currentPage < totalPages) { currentPage++; render(); }
                });

                render();
            })();
        </script>

        <script>
            (function () {
                const wrap = document.getElementById('ordersCardsBody');
                const bar = document.getElementById('ordersCardsPagination');
                if (!wrap || !bar) return;

                const allCards = Array.from(wrap.querySelectorAll(':scope > .order-card'));
                if (allCards.length === 0) { bar.style.display = 'none'; return; }

                const sizeSelect = document.getElementById('ordersCardsPageSize');
                const pageInfo = document.getElementById('ordersCardsPageInfo');
                const btnPrev = document.getElementById('ordersCardsPagePrev');
                const btnNext = document.getElementById('ordersCardsPageNext');

                let pageSize = localStorage.getItem('tvship-orders-pagesize') || '20';
                if (!['20', '50', '100', 'all'].includes(pageSize)) pageSize = '20';
                sizeSelect.value = pageSize;
                pageSize = pageSize === 'all' ? Number.MAX_SAFE_INTEGER : parseInt(pageSize, 10);
                let currentPage = 1;

                function render() {
                    const totalPages = Math.max(1, Math.ceil(allCards.length / pageSize));
                    if (currentPage > totalPages) currentPage = totalPages;
                    const start = (currentPage - 1) * pageSize;
                    const end = start + pageSize;

                    allCards.forEach((card, idx) => {
                        card.style.display = (idx >= start && idx < end) ? '' : 'none';
                    });

                    pageInfo.textContent = `Trang ${currentPage}/${totalPages} (${allCards.length} đơn)`;
                    btnPrev.disabled = currentPage <= 1;
                    btnNext.disabled = currentPage >= totalPages;
                    bar.style.display = allCards.length > 0 ? 'flex' : 'none';

                    window.scrollTo({ top: wrap.offsetTop - 80, behavior: 'smooth' });
                }

                sizeSelect.addEventListener('change', function () {
                    localStorage.setItem('tvship-orders-pagesize', this.value);
                    pageSize = this.value === 'all' ? Number.MAX_SAFE_INTEGER : parseInt(this.value, 10);
                    currentPage = 1;
                    render();
                });
                btnPrev.addEventListener('click', function () { if (currentPage > 1) { currentPage--; render(); } });
                btnNext.addEventListener('click', function () {
                    const totalPages = Math.max(1, Math.ceil(allCards.length / pageSize));
                    if (currentPage < totalPages) { currentPage++; render(); }
                });

                const totalPages = Math.max(1, Math.ceil(allCards.length / pageSize));
                const start = 0, end = pageSize;
                allCards.forEach((card, idx) => { card.style.display = (idx >= start && idx < end) ? '' : 'none'; });
                pageInfo.textContent = `Trang 1/${totalPages} (${allCards.length} đơn)`;
                btnPrev.disabled = true;
                btnNext.disabled = totalPages <= 1;
                bar.style.display = allCards.length > 0 ? 'flex' : 'none';
            })();
        </script>

