        async function loadProvincesAdmin(selectedVal, targetId = 'adm_jt_prov') {
            const res = await fetch('/api/address/provinces');
            const provinces = await res.json();
            const select = document.getElementById(targetId);

            if (!select) return;
            select.innerHTML = '<option value="">-- Chọn Tỉnh --</option>';
            provinces.forEach(p => {
                const isSelected = (p === selectedVal) ? 'selected' : '';
                select.innerHTML += `<option value="${p}" ${isSelected}>${p}</option>`;
            });
        }

        async function loadDistrictsAdmin(prov, selectedVal, targetId = 'adm_jt_dist') {
            if (!prov) return;
            const res = await fetch(`/api/address/districts?prov=${encodeURIComponent(prov)}`);
            const districts = await res.json();
            const select = document.getElementById(targetId);

            if (!select) return;
            select.innerHTML = '<option value="">-- Chọn Huyện --</option>';
            districts.forEach(d => {
                const isSelected = (d === selectedVal) ? 'selected' : '';
                select.innerHTML += `<option value="${d}" ${isSelected}>${d}</option>`;
            });
        }

        async function loadWardsAdmin(prov, dist, selectedVal, targetId = 'adm_jt_ward') {
            if (!dist) return;
            const res = await fetch(`/api/address/wards?prov=${encodeURIComponent(prov)}&district=${encodeURIComponent(dist)}`);
            const wards = await res.json();
            const select = document.getElementById(targetId);

            if (!select) return;
            select.innerHTML = '<option value="">-- Chọn Xã --</option>';
            wards.forEach(w => {
                const isSelected = (w === selectedVal) ? 'selected' : '';
                select.innerHTML += `<option value="${w}" ${isSelected}>${w}</option>`;
            });
        }
        async function saveOrderUpdate() {
            const orderId = document.getElementById('edit-order-id').value;
            const custName = document.getElementById('edit-cust-name').value.trim();
            const custPhone = document.getElementById('edit-cust-phone').value.trim();
            const custAddr = document.getElementById('edit-cust-addr').value.trim();
            const custCod = document.getElementById('edit-cust-cod').value;
            const custKg = document.getElementById('edit-cust-kg').value;
            const custId = document.getElementById('edit-cust-id').value;

            const prov = document.getElementById('edit_jt_prov').value;
            const dist = document.getElementById('edit_jt_dist').value;
            const ward = document.getElementById('edit_jt_ward').value;

            if (!custName || !custPhone) {
                return alert("Vui lòng điền đầy đủ Tên và SĐT khách hàng!");
            }

            const data = {
                id: orderId,
                customer_name: custName,
                customer_phone: custPhone,
                customer_address: custAddr,
                price: parseFloat(custCod) || 0,
                custId: custId,
                kg: custKg || 1,
                jt_prov: prov,
                jt_district: dist,
                jt_ward: ward
            };

            if (currentOrderData && currentOrderData.provider === 'NB') {
        const selectedRadio = document.querySelector('input[name="nbStatus"]:checked');
        if (selectedRadio) {
            data.status = selectedRadio.value;
        }
    }
            try {
                const res = await fetch('/api/admin/update-order', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();

                if (result.success) {
                    alert("✅ Cập nhật đơn hàng thành công!");
                    document.getElementById('modal-edit-order').style.display = 'none';
                    location.reload();
                } else {
                    alert("❌ Lỗi: " + result.message);
                }
            } catch (err) {
                console.error("Lỗi khi save đơn:", err);
                alert("Có lỗi xảy ra khi kết nối server!");
            }
        }

            (function() {
                function initTagSearch(tagBox, typingInput, hiddenInput, form) {
                    if (!tagBox || tagBox.dataset.tagInit) return;
                    tagBox.dataset.tagInit = 'true';

                    let tags = [];

                    const initVal = hiddenInput.value.trim();
                    if (initVal) {
                        initVal.split(',').map(s => s.trim()).filter(Boolean).forEach(addTag);
                    }

                    function syncHidden() {
                        hiddenInput.value = tags.join(',');
                    }

                    function addTag(code) {
                        code = code.trim();
                        if (!code || tags.includes(code)) return;
                        tags.push(code);
                        renderTags();
                        syncHidden();
                    }

                    function removeTag(code) {
                        tags = tags.filter(t => t !== code);
                        renderTags();
                        syncHidden();
                    }

                    function renderTags() {
                        Array.from(tagBox.querySelectorAll('.search-tag')).forEach(el => el.remove());
                        tags.forEach(code => {
                            const chip = document.createElement('span');
                            chip.className = 'search-tag badge d-inline-flex align-items-center gap-1';
                            chip.style.cssText = 'background:#ffe0e0;color:#c0392b;border:1px solid #f5a0a0;font-size:0.72rem;padding:2px 6px;border-radius:4px;cursor:default;white-space:nowrap;width:calc(25% - 4px);min-width:0;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box;';
                            chip.innerHTML = `<span style="overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0;">${code}</span><span style="cursor:pointer;font-size:0.85rem;line-height:1;flex-shrink:0;" data-code="${code}">&times;</span>`;
                            chip.querySelector('span[data-code]').addEventListener('click', function(e) {
                                e.stopPropagation();
                                removeTag(this.dataset.code);
                            });
                            tagBox.insertBefore(chip, typingInput);
                        });
                        typingInput.style.width = tags.length % 4 === 0 ? '100%' : 'calc(25% - 4px)';
                        typingInput.style.minWidth = tags.length % 4 === 0 ? '80px' : '60px';
                        typingInput.placeholder = tags.length > 0 ? '' : 'Tên, SĐT, Mã đơn...';
                    }

                    tagBox.addEventListener('click', function() { typingInput.focus(); });

                    typingInput.addEventListener('paste', function(e) {
                        e.preventDefault();
                        const pasted = (e.clipboardData || window.clipboardData).getData('text');
                        if (!pasted) return;
                        const codes = pasted.split(/[\n\r\t,\s]+/).map(s => s.trim()).filter(Boolean);
                        codes.forEach(addTag);
                        typingInput.value = '';
                        syncHidden();
                        form.submit();
                    });

                    typingInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            const val = this.value.trim();
                            if (val) {
                                addTag(val);
                                this.value = '';
                                syncHidden();
                                form.submit();
                            } else if (tags.length > 0) {
                                form.submit();
                            }
                        } else if (e.key === 'Backspace' && this.value === '' && tags.length > 0) {
                            removeTag(tags[tags.length - 1]);
                        }
                    });

                    form.addEventListener('submit', function() { syncHidden(); });
                }

                function initAll() {
                    const desktopForm = document.querySelector('form.d-none.d-md-flex');
                    initTagSearch(
                        document.getElementById('adminTagBox'),
                        document.getElementById('adminTagTyping'),
                        document.getElementById('adminSearchHidden'),
                        desktopForm
                    );

                    const mobileForm = document.querySelector('#filter-drawer form');
                    initTagSearch(
                        document.getElementById('adminTagBoxMobile'),
                        document.getElementById('adminTagTypingMobile'),
                        document.getElementById('adminSearchHiddenMobile'),
                        mobileForm
                    );
                    const adminTagTyping = document.getElementById('adminTagTyping');
                    if (adminTagTyping) {
                        adminTagTyping.focus();
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initAll);
                } else {
                    initAll();
                }
            })();
        </script>
