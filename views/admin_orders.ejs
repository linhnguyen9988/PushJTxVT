            function calculateSummary() {
                const elCod = document.getElementById('sum_cod');
                const elFee = document.getElementById('sum_fee');
                const elRec = document.getElementById('sum_received');

                if (!elCod || !elFee || !elRec) return;

                let totalCod = 0;
                let totalFee = 0;
                const processedCodes = new Set();
                const allOrders = document.querySelectorAll('.order-checkbox');

                allOrders.forEach(cb => {
                    try {
                        const order = JSON.parse(cb.getAttribute('data-order'));
                        if (!processedCodes.has(order.order_code)) {
                            processedCodes.add(order.order_code);
                            totalCod += parseFloat(order.price) || 0;
                            totalFee += parseFloat(order.internal_fee) || 0;
                        }
                    } catch (e) { }
                });

                elCod.innerText = Math.floor(totalCod).toLocaleString('vi-VN') + "đ";
                elFee.innerText = Math.floor(totalFee).toLocaleString('vi-VN') + "đ";
                elRec.innerText = Math.floor(totalCod - totalFee).toLocaleString('vi-VN') + "đ";
            }

            document.addEventListener('DOMContentLoaded', calculateSummary);
            function copyToClipboard(text, el) {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(() => {
                        showSuccessEffect(el);
                    });
                } else {
                    const textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    textArea.style.top = "-999999px";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        showSuccessEffect(el);
                    } catch (err) {
                        console.error('Không thể copy bằng cách cũ: ', err);
                    }
                    document.body.removeChild(textArea);
                }
            }

            function showSuccessEffect(el) {
                const icon = el.querySelector('i') || el;
                const originalClass = icon.className;
                icon.className = 'fas fa-check text-success';
                setTimeout(() => {
                    icon.className = originalClass;
                }, 1000);
            }
            function exportToExcel() {
                const start = document.querySelector('input[name="startDate"]').value;
                const end = document.querySelector('input[name="endDate"]').value;
                const dateType = document.querySelector('select[name="dateType"]').value;
                const status = document.querySelector('select[name="status"]')?.value || '';
                const search = document.getElementById('adminSearchHidden')?.value || '';
                const providerSelect = document.querySelector('select[name="provider"]')?.value || '';
                const providerRadio = document.querySelector('input[name="provider"]:checked')?.value || '';
                const provider = providerSelect || providerRadio || '';

                if (!start || !end) {
                    showNotice("Cảnh báo", "Bạn cần chọn ngày trước khi xuất file!", "warning");
                    return;
                }

                const params = new URLSearchParams({ isAdmin: '1', startDate: start, endDate: end, dateType });
                if (status) params.set('status', status);
                if (search) params.set('search', search);
                if (provider) params.set('provider', provider);

                window.location.href = `/api/orders/export-excel?${params.toString()}`;
            }

            function closeJtTrackingPopup() {
                document.getElementById('jtTrackingPopup').style.display = 'none';
            }
            function formatVNTime(dateString) {
                if (!dateString) return '';
                const d = new Date(dateString);
                if (isNaN(d.getTime())) return dateString; 

                const day = String(d.getDate()).padStart(2, '0');
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const year = d.getFullYear();
                const hours = String(d.getHours()).padStart(2, '0');
                const minutes = String(d.getMinutes()).padStart(2, '0');
                const seconds = String(d.getSeconds()).padStart(2, '0');

                return `${hours}:${minutes}:${seconds} - ${day}/${month}/${year}`;
            }
            let currentTrackingBillCode = null;
            let currentTrackingIsJT = false;
            let __trackingPhotoSets = [];

            // Bản sao (phía client) của statusMap server-side để cập nhật lại badge trạng thái
            // trên danh sách đơn ngay sau khi refresh hành trình thành công, không cần load lại trang.
            const clientStatusMap = {
                'pending':          { text: 'Chờ lấy hàng', class: 'bg-warning-subtle text-warning-emphasis border border-warning' },
                'cancel':           { text: 'Đã hủy đơn',   class: 'bg-secondary-subtle text-secondary border border-secondary' },
                'picked_up':        { text: 'Đã lấy hàng',  class: 'bg-info-subtle text-info-emphasis border border-info' },
                'delivering':       { text: 'Đang vận chuyển', class: 'bg-primary-subtle text-primary border border-primary badge-original-blue' },
                'out_for_delivery': { text: 'Đang giao hàng', class: 'bg-primary border text-white badge-original-blue' },
                'completed':        { text: 'Thành công',    class: 'bg-success-subtle text-success border border-success' },
                'returning':        { text: 'Đang hoàn', class: 'bg-danger-subtle text-danger border border-danger' },
                'returned':         { text: 'Đã hoàn hàng',  class: 'bg-dark-subtle text-dark border border-dark' },
                'issue':            { text: 'Kiện vấn đề',   class: 'bg-danger text-white border border-danger' }
            };

            function updateOrderStatusBadge(billCode, status) {
                if (!billCode || !status) return;
                const info = clientStatusMap[status];
                if (!info) return;
                document.querySelectorAll(`.badge[data-billcode="${CSS.escape(billCode)}"]`).forEach(el => {
                    el.className = `badge rounded-pill ${info.class} mt-1`;
                    el.innerText = info.text;
                });
            }

            // Ảnh hành trình: cột sigpic lưu JSON string mảng URL (có thể nhiều ảnh/1 mốc).
            // Hiện tấm đầu tiên làm thumbnail, bấm vào để mở lightbox xem hết các tấm còn lại.
            function renderJtImages(sigpicRaw) {
                if (!sigpicRaw) return '';
                let pics = [];
                try {
                    const parsed = JSON.parse(sigpicRaw);
                    pics = Array.isArray(parsed) ? parsed : [parsed];
                } catch (e) {
                    pics = [sigpicRaw]; // dữ liệu cũ có thể chỉ là 1 URL đơn (chưa qua JSON)
                }
                pics = pics.filter(u => typeof u === 'string' && u.trim() !== '');
                if (pics.length === 0) return '';

                const setIdx = __trackingPhotoSets.push(pics) - 1;
                return `
        <div class="tracking-photo-wrap" onclick="openTrackingLightbox(${setIdx})">
            <img src="${pics[0]}" class="tracking-photo-thumb" loading="lazy" alt="Ảnh hành trình">
            ${pics.length > 1 ? `<span class="tracking-photo-count"><i class="fas fa-images"></i> ${pics.length}</span>` : ''}
        </div>`;
            }

            function buildJtTimelineHtml(trackingData) {
                __trackingPhotoSets = [];
                if (!trackingData || trackingData.length === 0) {
                    return `<div class="text-center py-5"><p class="text-muted">Không tìm thấy lịch sử hành trình chi tiết.</p></div>`;
                }
                return trackingData.map((item, idx) => {
                    const displayStatus = item.scantypename || 'Cập nhật hành trình';
                    var issueName = '';
                    if (item.issuename != null){
                        issueName = ' - ' + item.issuename;
                    }else{
                        issueName = '';
                    }
                    const isWarning = displayStatus.includes('hủy') || displayStatus.includes('vấn đề') || displayStatus.includes('取消');

                    const addressParts = [
                        item.scanpost,
                        item.scanward,
                        item.scancity,
                        item.scanprov
                    ].filter(part => part && part.trim() !== ''); 

                    const fullAddress = addressParts.length > 0 ? addressParts.join(', ') : 'Chưa xác định...';

                    return `
    <div class="timeline-item ${isWarning ? 'status-warning' : ''}">
        <div class="timeline-date">
            <i class="far fa-clock"></i> ${formatVNTime(item.scantime)}
        </div>
        <div class="status-title ${isWarning ? 'text-danger' : (idx === 0 ? 'text-primary' : '')}">
            ${displayStatus}${issueName}
        </div>
        <div class="location-info">
            <i class="fas fa-map-marker-alt text-secondary me-1"></i>
            ${fullAddress}
        </div>
        ${item.scanbyname ? `
            <div class="staff-info">
                <i class="fas fa-user-check me-1"></i>
                <b>Bưu tá:</b> ${item.scanbyname} ${item.scanbycontact ? `(${item.scanbycontact})` : ''}
            </div>
        ` : ''}
        ${renderJtImages(item.sigpic)}
    </div>`;
                }).join('');
            }

            async function handleOrderClick(billCode, status, provider) {
                const popup = document.getElementById('jtTrackingPopup');
                const container = document.getElementById('jtTrackingTimeline');
                const billCodeHeader = document.getElementById('jtTrackingBillCode');
                const refreshBtn = document.getElementById('btnRefreshJtTracking');

                const isJT = provider === 'J&T' || provider === 'JTE';
                const isLocalTracking = isJT || provider === 'NB';
                currentTrackingBillCode = billCode;
                currentTrackingIsJT = isJT;
                if (refreshBtn) refreshBtn.classList.toggle('d-none', !isJT);

                if (billCodeHeader) billCodeHeader.innerText = billCode;
                popup.style.display = 'flex';

                container.innerHTML = `<div class="text-center p-5"><div class="spinner-border text-primary"></div><p class="mt-2">Đang tải...</p></div>`;

                try {
                    const apiUrl = isLocalTracking ? `/api/orders/track-jt/${billCode}` : `/api/viettel/trace?billCode=${billCode}`;

                    const res = await fetch(apiUrl);
                    if (!res.ok) throw new Error('Network response was not ok');
                    const result = await res.json();

                    if (result.success || result.code === '1') {
                        let html = '';

                        if (isLocalTracking && result.trackingData && result.trackingData.length > 0) {
                            html = buildJtTimelineHtml(result.trackingData);
                        }
                        else if (!isLocalTracking && result.data && result.data.details && result.data.details.length > 0) {
                            const details = [...result.data.details].reverse();
                            html = details.map((item, idx) => `
                    <div class="timeline-item">
                        <div class="timeline-date">${item.scanTime}</div>
                        <div class="status-title ${idx === 0 ? 'text-primary' : ''}">${item.scanType}</div>
                        <div class="location-info">${item.desc}</div>
                    </div>`).join('');
                        } else {
                            html = `<div class="text-center py-5"><p class="text-muted">Không tìm thấy lịch sử hành trình chi tiết.</p></div>`;
                        }

                        container.innerHTML = html;
                    } else {
                        container.innerHTML = `<div class="text-center py-5 text-warning">Hãng vận chuyển chưa cập nhật hành trình.</div>`;
                    }
                } catch (e) {
                    console.error("Lỗi:", e);
                    container.innerHTML = `<div class="text-center py-5 text-danger">Lỗi kết nối máy chủ.</div>`;
                }
            }

            async function refreshJtTracking() {
                if (!currentTrackingBillCode || !currentTrackingIsJT) return;
                const container = document.getElementById('jtTrackingTimeline');
                const btn = document.getElementById('btnRefreshJtTracking');
                const icon = btn ? btn.querySelector('i') : null;

                if (btn) btn.disabled = true;
                if (icon) icon.classList.add('fa-spin');

                try {
                    const res = await fetch(`/api/orders/track-jt/${currentTrackingBillCode}/refresh`, { method: 'POST' });
                    if (!res.ok) throw new Error('Network response was not ok');
                    const result = await res.json();

                    if (result.success && result.trackingData && result.trackingData.length > 0) {
                        container.innerHTML = buildJtTimelineHtml(result.trackingData);
                        if (result.updatedStatus) {
                            updateOrderStatusBadge(currentTrackingBillCode, result.updatedStatus);
                        }
                    } else {
                        alert(result.message || 'Không lấy được hành trình mới từ J&T!');
                    }
                } catch (e) {
                    console.error("Lỗi refresh hành trình:", e);
                    alert('Lỗi kết nối máy chủ khi tra hành trình!');
                } finally {
                    if (btn) btn.disabled = false;
                    if (icon) icon.classList.remove('fa-spin');
                }
            }

            let __lightboxImages = [];
            let __lightboxIndex = 0;
            function openTrackingLightbox(setIdx) {
                __lightboxImages = __trackingPhotoSets[setIdx] || [];
                if (__lightboxImages.length === 0) return;
                __lightboxIndex = 0;
                updateLightboxView();
                document.getElementById('trackingLightbox').style.display = 'flex';
            }
            function updateLightboxView() {
                document.getElementById('trackingLightboxImg').src = __lightboxImages[__lightboxIndex];
                document.getElementById('trackingLightboxCounter').innerText = `${__lightboxIndex + 1} / ${__lightboxImages.length}`;
                document.getElementById('trackingLightboxNav').style.display = __lightboxImages.length > 1 ? 'flex' : 'none';
            }
            function lightboxPrev(e) {
                e.stopPropagation();
                __lightboxIndex = (__lightboxIndex - 1 + __lightboxImages.length) % __lightboxImages.length;
                updateLightboxView();
            }
            function lightboxNext(e) {
                e.stopPropagation();
                __lightboxIndex = (__lightboxIndex + 1) % __lightboxImages.length;
                updateLightboxView();
            }
            function closeTrackingLightbox() {
                document.getElementById('trackingLightbox').style.display = 'none';
            }

