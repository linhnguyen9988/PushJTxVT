<%- include('partials/header') %>
<%- include('partials/admin_theme') %>
    <% 
var statusMap = {
    'pending':          { text: 'Chờ lấy hàng', class: 'bg-warning-subtle text-warning-emphasis border border-warning' },
    'cancel':           { text: 'Đã hủy đơn',   class: 'bg-secondary-subtle text-secondary border border-secondary' },
    'picked_up':        { text: 'Đã lấy hàng',  class: 'bg-info-subtle text-info-emphasis border border-info' },
    'delivering':       { text: 'Đang vận chuyển', class: 'bg-primary-subtle text-primary border border-primary badge-original-blue' },
    'out_for_delivery': { text: 'Đang giao hàng', class: 'bg-primary border text-white badge-original-blue' },
    'completed':        { text: 'Thành công',    class: 'bg-success-subtle text-success border border-success' },
    'returning':        { text: 'Đang hoàn', class: 'bg-danger-subtle text-danger border border-danger' },
    'returned':         { text: 'Đã hoàn hàng',  class: 'bg-dark-subtle text-dark border border-dark' },
    'issue':            { text: 'Kiện vấn đề',   class: 'bg-danger text-white border border-danger' }
};

function getBadge(status) {
    var s = status ? status.toLowerCase() : '';
    return statusMap[s] || { text: status || 'N/A', class: 'bg-light text-dark border' };
}
%>
        <div class="container-fluid px-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="page-title-adm mb-0"><span class="ic">📦</span> Đơn hàng</h4>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-outline-primary btn-sm px-3 shadow-sm"
                        onclick="printSelectedOrders()">
                        <i class="fas fa-print me-1"></i> In (<span id="selectedCount">0</span>)
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" onclick="showPopup()">
                        <i class="fas fa-plus-circle me-1"></i>
                    </button>
                </div>
            </div>

            <div class="nav-tabs-custom mb-3 shadow-sm sticky-top" style="top: -1px; background: var(--surface-card); z-index: 100;">
    <a class="nav-link <%= !status ? 'active' : '' %>" 
       href="/admin/orders?startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Tất cả <span class="badge rounded-pill bg-secondary badge-count"><%= counts.total %></span>
    </a>

    <a class="nav-link tab-pending <%= status === 'pending' ? 'active' : '' %>" 
       href="/admin/orders?status=pending&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Chờ lấy <span class="badge rounded-pill bg-warning text-dark badge-count"><%= counts.pending %></span>
    </a>

    <a class="nav-link tab-shipping <%= ['picked_up','delivering'].includes(status) ? 'active' : '' %>" 
       href="/admin/orders?status=delivering&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Đang vận chuyển <span class="badge rounded-pill bg-info badge-count"><%= counts.shipping %></span>
    </a>

    <a class="nav-link tab-delivery <%= status === 'out_for_delivery' ? 'active' : '' %>" 
       href="/admin/orders?status=out_for_delivery&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Đang giao <span class="badge rounded-pill bg-info badge-count"><%= counts.delivery %></span>
    </a>

    <a class="nav-link tab-issue <%= status === 'issue' ? 'active' : '' %>" 
       href="/admin/orders?status=issue&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Vấn đề <span class="badge rounded-pill bg-danger badge-count"><%= counts.issue %></span>
    </a>

    <a class="nav-link tab-success <%= status === 'completed' ? 'active' : '' %>" 
       href="/admin/orders?status=completed&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Thành công <span class="badge rounded-pill bg-success badge-count"><%= counts.completed %></span>
    </a>

    <a class="nav-link tab-returned <%= ['returning','returned'].includes(status) ? 'active' : '' %>" 
       href="/admin/orders?status=returned&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Đơn hoàn <span class="badge rounded-pill bg-dark badge-pill badge-count"><%= counts.returned %></span>
    </a>

    <a class="nav-link tab-cancel <%= status === 'cancel' ? 'active' : '' %>" 
       href="/admin/orders?status=cancel&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        Đã hủy <span class="badge rounded-pill bg-light text-muted border badge-count"><%= counts.cancel %></span>
    </a>

    <a class="nav-link <%= printed === '1' ? 'active' : '' %>" 
       href="/admin/orders?printed=1&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        🖨️ Đã in <span class="badge rounded-pill bg-secondary badge-count"><%= counts.printed || 0 %></span>
    </a>

    <a class="nav-link <%= printed === '0' ? 'active' : '' %>" 
       href="/admin/orders?printed=0&startDate=<%= startDate %>&endDate=<%= endDate %>&search=<%= search %>&provider=<%= provider %>&dateType=<%= dateType %>">
        ⬜ Chưa in <span class="badge rounded-pill bg-warning text-dark badge-count"><%= counts.not_printed || 0 %></span>
    </a>
</div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-2 p-md-3">
                    <form action="/admin/orders" method="GET" class="row g-2 align-items-end d-none d-md-flex mb-3">
                        <input type="hidden" name="printed" value="">
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted ml-1">Tìm kiếm</label>
                            <input type="hidden" name="search" id="adminSearchHidden" value="<%= search %>">
                            <div id="adminTagBox" class="tag-search-box form-control form-control-sm shadow-sm d-flex flex-wrap align-items-center gap-1 p-1" style="min-height:31px;cursor:text;height:auto;">
                                <input type="text" id="adminTagTyping" class="tag-typing-input border-0 outline-0 flex-grow-1"
                                    placeholder="Tên, SĐT, Mã đơn..." autocomplete="off"
                                    style="min-width:80px;outline:none;font-size:0.8rem;padding:1px 2px;">
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Lọc theo ngày</label>
                            <select name="dateType" class="form-select form-select-sm shadow-sm">
                                <option value="created" <%=dateType==='created' ? 'selected' : '' %>>Ngày tạo đơn</option>
                                <option value="pickup" <%=dateType==='pickup' ? 'selected' : '' %>>Ngày lấy hàng</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Từ ngày</label>
                            <input type="date" name="startDate" class="form-control form-control-sm shadow-sm"
                                value="<%= startDate %>">
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Đến ngày</label>
                            <input type="date" name="endDate" class="form-control form-control-sm shadow-sm"
                                value="<%= endDate %>">
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Trạng thái</label>
                            <select name="status" class="form-select form-select-sm shadow-sm">
                                <option value="">Tất cả trạng thái</option>
                                <option value="pending" <%=status==='pending' ? 'selected' : '' %>>Chờ lấy</option>
                                <option value="shipping" <%=status==='shipping' ? 'selected' : '' %>>Đang giao</option>
                                <option value="success" <%=status==='success' ? 'selected' : '' %>>Thành công</option>
                                <option value="cancel" <%=status==='cancel' ? 'selected' : '' %>>Đã hủy</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Đơn vị vận chuyển</label>
                            <select name="provider" class="form-select form-select-sm shadow-sm">
                                <option value="">Tất cả ĐVVC</option>
                                <option value="J&T" <%=provider==='J&T' ? 'selected' : '' %>>J&T Express</option>
                                <option value="Viettel" <%=provider==='Viettel' ? 'selected' : '' %>>Viettel Post</option>
                                <option value="NB" <%=provider==='NB' ? 'selected' : '' %>>Biên Hòa</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="small fw-bold text-muted ml-1">Trạng thái in</label>
                            <select name="printed" class="form-select form-select-sm shadow-sm">
                                <option value="">Tất cả</option>
                                <option value="1" <%=printed==='1' ? 'selected' : '' %>>🖨️ Đã in</option>
                                <option value="0" <%=printed==='0' ? 'selected' : '' %>>⬜ Chưa in</option>
                            </select>
                        </div>

                        <div class="col-md-1">
                            <div class="d-flex gap-1">
                                <button type="submit" class="btn btn-primary btn-sm flex-grow-1 shadow-sm fw-bold" title="Lọc">
                                    <i class="fas fa-filter"></i>
                                </button>
                                <a href="/admin/orders" class="btn btn-outline-secondary btn-sm shadow-sm" title="Xóa lọc">
                                    <i class="fas fa-undo"></i>
                                </a>
                            </div>
                        </div>

                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-success btn-sm shadow-sm fw-bold w-100"
                                onclick="exportToExcel()">
                                <i class="fa-solid fa-file-excel"></i> Xuất Excel
                            </button>
                        </div>
                    </form>


                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="stat-chip-mini c-yellow">
                                <div class="chip-label">Tổng COD</div>
                                <div class="chip-val" id="sum_cod">0đ</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-chip-mini c-red">
                                <div class="chip-label">Tổng Cước</div>
                                <div class="chip-val" id="sum_fee">0đ</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-chip-mini c-green">
                                <div class="chip-label">Thực nhận</div>
                                <div class="chip-val" id="sum_received">0đ</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/messages') %>

                <div class="desktop-view">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="table-layout:fixed;">
                                <thead>
                                    <tr>
                                        <th class="ps-3" style="width:36px;"><input type="checkbox" class="form-check-input" id="selectAll"
                                                onclick="toggleAll(this)"></th>
                                        <th style="width:9%;">Shop</th>
                                        <th style="width:18%;">Mã đơn / Trạng thái</th>
                                        <th style="width:12%;">Khách hàng</th>
                                        <th style="width:28%;">Địa chỉ</th>
                                        <th style="width:11%;">COD / Cước</th>
                                        <th class="text-success" style="width:9%;">Thực nhận</th>
                                        <th style="width:6%;">ĐVVC</th>
                                        <th class="text-center" style="width:4%;" title="Trạng thái in">In</th>
                                        <th class="text-center" style="width:7%;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="ordersTableBody">
    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(function(order, i) { 
            const statusInfo = getBadge(order.status);
            const displayCode = (order.provider === 'J&T' && order.realjtbillcode) ? order.realjtbillcode : order.order_code; 
        %>
            <tr>
                <td class="ps-3">
                    <input type="checkbox" class="form-check-input order-checkbox"
                        data-provider="<%= order.provider %>"
                        data-status="<%= order.status %>"
                        data-order='<%= JSON.stringify({order_code: order.order_code, customer_name: order.customer_name, customer_phone: order.customer_phone, customer_address: order.customer_address, price: order.price, internal_fee: order.internal_fee, provider: order.provider, shop_name: stats.vtp_shop_name}).replace(/'/g, "&#39;") %>'>
                </td>
                <td>
                    <div class="fw-bold text-nowrap" style="font-size:0.8rem;"><%= order.shopname %></div>
                </td>
                <td>
                    <div class="order-code-link"
                        onclick="handleOrderClick('<%= displayCode %>', '<%= order.status %>', '<%= order.provider %>')">
                        📦 <%= displayCode %>
                        <i class="far fa-copy copy-ic"
                            onclick="event.stopPropagation(); copyToClipboard('<%= displayCode %>', this)"></i>
                    </div>

                    <span class="badge rounded-pill <%= statusInfo.class %> mt-1" data-billcode="<%= displayCode %>"
                        style="font-size: 0.65rem; padding: 0.4em 0.8em;">
                        <%= statusInfo.text %>
                    </span>
                    <% if (order.issue) { %>
                        <div class="order-issue-chip">
                            <i class="fas fa-exclamation-circle pulse-red"></i> <%= order.issue %>
                        </div>
                    <% } %>

                    <div class="order-meta-line">
                        <i class="fa-solid fa-scale-balanced"></i>
                        <%= order.product_name %> x <%= Number(order.weight).toLocaleString() %> KG
                    </div>
                    <div class="order-meta-line">
                        <i class="far fa-clock"></i>
                        <%= new Date(order.created_at).toLocaleString('vi-VN').replace(',', ' -') %>
                    </div>
                </td>
                <td onclick="copyToClipboard('<%= order.customer_phone %>', this)" style="cursor: pointer;">
                    <div class="fw-bold text-nowrap"><%= order.customer_name %></div>
                    <div class="small text-muted">
                        <%= order.customer_phone %> <i class="far fa-copy" style="font-size: 0.6rem;"></i>
                    </div>
                </td>
                <td>
                    <div class="table-address" style="word-break:break-word;white-space:normal;font-size:0.85rem;">
                        <%= order.customer_address %>
                        <% if ((order.provider === 'J&T' || order.provider === 'NB') && (order.jt_ward || order.jt_district || order.jt_prov)) { %>
                        <div class="text-muted small mt-1">
                            <i class="fas fa-map-pin" style="font-size:0.7rem"></i>
                            <%= [order.jt_ward, order.jt_district, order.jt_prov].filter(Boolean).join(', ') %>
                        </div>
                        <% } %>
                    </div>
                </td>
                <td>
                    <div class="fw-bold"><%= Number(order.price).toLocaleString() %>đ</div>
                    <div class="text-danger small"><i class="fas fa-minus"></i>
                        <%= Number(order.internal_fee || 0).toLocaleString() %>đ
                    </div>
                    <% if (order.original_cod !== null && order.original_cod !== undefined && Number(order.original_cod) !== Number(order.price)) { %>
                    <span class="badge bg-warning text-dark mt-1" title="Đơn hàng đã bị sửa COD">
                        <i class="fas fa-pen"></i> COD gốc: <%= Number(order.original_cod).toLocaleString() %>đ
                    </span>
                    <% } %>
                </td>
                <td class="fw-bold text-success">
                    <%= (Number(order.price) - Number(order.internal_fee || 0)).toLocaleString() %>đ
                </td>
                <td>
                    <img class="provider-logo" src="/img/<%= order.provider === 'Viettel' ? 'viettel.png' : (order.provider === 'NB' ? 'nb.png' : 'jte.png') %>">
                </td>
                <td class="text-center">
                    <% if (order.is_printed) { %>
                        <i class="fas fa-print text-success print-status-ic"
                           title="Đã in <%= order.is_printed %> lần - lần đầu: <%= order.printed_at ? new Date(order.printed_at).toLocaleString('vi-VN') : '' %>"></i>
                    <span class="print-status-count" style="color:var(--success);"><%= order.is_printed %>x</span>
                    <% } else { %>
                        <i class="fas fa-print text-danger print-status-ic" title="Chưa in"></i>
                    <% } %>
                </td>
                <td class="text-center">
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" 
                                data-index="<%= i %>" onclick="prepareEditOrder(Number(this.dataset.index))" title="Sửa đơn hàng">
                            <i class="fas fa-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary btn-print-single"
                            data-order='<%= JSON.stringify({order_code: order.order_code, customer_name: order.customer_name, customer_phone: order.customer_phone, customer_address: order.customer_address, price: order.price, provider: order.provider, shop_name: stats.vtp_shop_name}).replace(/'/g, "&#39;").replace(/[\r\n]/g, " ") %>'>
                            <i class="fas fa-print"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                            onclick="cancelOrder('<%= order.order_code %>', '<%= order.provider %>')">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </td>
            </tr>
        <% }); %>
    <% } else { %>
        <tr>
            <td colspan="9" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào</td>
        </tr>
    <% } %>
</tbody>
                            </table>
                        </div>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-top" id="ordersPagination" style="display:none;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Hiển thị</span>
                                <select id="ordersPageSize" class="form-select form-select-sm" style="width:auto;">
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="all">Tất cả</option>
                                </select>
                                <span class="text-muted small">đơn / trang</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small" id="ordersPageInfo">Trang 1/1</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" id="ordersPagePrev"><i class="fas fa-chevron-left"></i></button>
                                    <button class="btn btn-outline-secondary" id="ordersPageNext"><i class="fas fa-chevron-right"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mobile-view">
    <div class="d-flex align-items-center mb-3 p-3 bg-white shadow-sm rounded border">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="selectAllMobile" onclick="toggleAll(this)">
            <label class="form-check-label fw-bold ms-2" for="selectAllMobile">
                Chọn tất cả
            </label>
        </div>
    </div>

    <div id="ordersCardsBody">
    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(function(order, i) { 
            var statusInfo = getBadge(order.status);
            var displayCode = (order.provider === 'J&T' && order.realjtbillcode) ? order.realjtbillcode : order.order_code;
            
            var pData = {
                order_code: order.order_code,
                customer_name: order.customer_name,
                customer_phone: order.customer_phone,
                customer_address: order.customer_address,
                price: order.price,
                provider: order.provider,
                shop_name: stats.vtp_shop_name
            };
        %>
        
        <div class="order-card <%= order.provider === 'Viettel' ? 'border-danger' : 'border-warning' %>">
            <div class="order-card-header">
                <div class="d-flex align-items-start gap-2">
                    <input type="checkbox" class="form-check-input order-checkbox mt-1" 
                            data-status="<%= order.status %>"
                            data-provider="<%= order.provider %>" 
                            data-order='<%- JSON.stringify(pData).replace(/'/g, "&#39;") %>'>

                    <div>
                        <div class="order-code-link"
                              onclick="handleOrderClick('<%= displayCode %>', '<%= order.status %>', '<%= order.provider %>')">
                            📦 <%= displayCode %>
                            <i class="far fa-copy copy-ic"
                               onclick="event.stopPropagation(); copyToClipboard('<%= displayCode %>', this)"></i>
                        </div>
                        <span class="badge rounded-pill <%= statusInfo.class %> mt-1" data-billcode="<%= displayCode %>" style="font-size: 0.62rem;">
                            <%= statusInfo.text %>
                        </span>
                        <span class="order-card-shop d-block mt-1" style="width:fit-content;"><%= order.shopname %></span>
                    </div>
                </div>
                <div class="d-flex flex-column align-items-center gap-1">
                    <% if (order.is_printed) { %>
                        <span class="d-flex flex-column align-items-center" title="Đã in <%= order.is_printed %> lần - lần đầu: <%= order.printed_at ? new Date(order.printed_at).toLocaleString('vi-VN') : '' %>">
                <i class="fas fa-print text-success print-status-ic"></i>
                <span class="print-status-count" style="color:var(--success);"><%= order.is_printed %>x</span>
            </span>
                    <% } else { %>
                        <i class="fas fa-print text-danger print-status-ic" title="Chưa in"></i>
                    <% } %>
                    <img class="provider-logo" src="/img/<%= order.provider === 'Viettel' ? 'viettel.png' : (order.provider === 'NB' ? 'nb.png' : 'jte.png') %>">
                </div>
            </div>

            <% if (order.issue) { %>
                <div class="order-issue-chip d-flex align-items-center">
                    <i class="fas fa-circle-exclamation me-2 pulse-red"></i>
                    <span><%= order.issue %></span>
                </div>
            <% } %>

            <div class="order-meta-line">
                <i class="fa-solid fa-scale-balanced"></i> <%= order.product_name %> x <%= (order.weight).toLocaleString() %> KG — <%= new Date(order.created_at).toLocaleString('vi-VN').replace(',', ' -') %>
            </div>

            <div class="order-card-customer" onclick="copyToClipboard('<%= order.customer_phone %>', this)">
                <%= order.customer_name %> — <%= order.customer_phone %>
                <i class="far fa-copy ms-1 text-muted"></i>
            </div>

            <div class="order-card-address">
                <i class="fas fa-map-marker-alt me-1"></i><%= order.customer_address %>
                <% if ((order.provider === 'J&T' || order.provider === 'NB') && (order.jt_ward || order.jt_district || order.jt_prov)) { %>
                <span class="d-block mt-1">
                    <i class="fas fa-map-pin" style="font-size:0.65rem"></i>
                    <%= [order.jt_ward, order.jt_district, order.jt_prov].filter(Boolean).join(', ') %>
                </span>
                <% } %>
            </div>

            <div class="order-card-stats">
                <div>
                    <div class="stat-label">COD</div>
                    <div class="stat-value"><%= Number(order.price).toLocaleString() %>đ</div>
                    <% if (order.original_cod !== null && order.original_cod !== undefined && Number(order.original_cod) !== Number(order.price)) { %>
                    <span class="badge bg-warning text-dark mt-1" title="Đơn hàng đã bị sửa COD">
