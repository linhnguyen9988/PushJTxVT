            async function printViaSocket(orderCodes) {
                const loader = document.createElement('div');
                loader.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;color:white;z-index:9999;font-family:sans-serif;flex-direction:column;gap:10px;';
                loader.innerHTML = `<i class="fas fa-spinner fa-spin fa-2x"></i><div>Đang gửi lệnh in qua App C#...</div>`;
                document.body.appendChild(loader);
                try {
                    const res = await fetch('/api/print-orders-socket', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: orderCodes, userId: CURRENT_USER_ID })
                    });
                    const data = await res.json();
                    loader.remove();
                    if (data.success) {
                        showNotice('Đã gửi lệnh in', data.message, 'success');
                        await markOrdersPrinted(orderCodes);
                    } else {
                        showNotice('Lỗi in', data.message || 'Không thể gửi lệnh in', 'error');
                    }
                } catch (e) {
                    loader.remove();
                    showNotice('Lỗi', 'Không kết nối được server!', 'error');
                }
