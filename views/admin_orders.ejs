            async function printSelectedOrders() {
    const selectedBoxes = document.querySelectorAll('.order-checkbox:checked');
    if (selectedBoxes.length === 0) return showNotice("Lỗi", "Không có đơn hàng nào được chọn", "error");

    const orderCodes = Array.from(selectedBoxes).map(box => {
        const order = JSON.parse(box.getAttribute('data-order'));
        return order.order_code;
    });


    if (_useSocketPrint) {
        return printViaSocket(orderCodes);
    }

    const isMobile = isMobileDevice();
    const apiUrl = isMobile ? '/api/print-orders-multi-mobile' : '/api/print-orders-multi';

    const loader = document.createElement('div');
    loader.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;color:white;z-index:9999;';
    loader.innerHTML = 'Đang tạo bản in...';
    document.body.appendChild(loader);

    try {
        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: orderCodes })
        });

        if (!response.ok) throw new Error("Phản hồi từ server không tốt");

        if (isMobile) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank'; 
            link.download = `tem-in-${orderCodes[0]}.pdf`; 
            document.body.appendChild(link);
            link.click();
            link.remove();
            
            setTimeout(() => window.URL.revokeObjectURL(url), 1000);
        } else {
            const html = await response.text();
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            document.body.appendChild(iframe);

            window.addEventListener('message', function handler(e) {
                if (e.data === 'close-print-frame') {
                    document.body.removeChild(iframe);
                    window.removeEventListener('message', handler);
                }
            });

            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(html);
            doc.close();
        }

        await markOrdersPrinted(orderCodes);

    } catch (err) {
        console.error(err);
        alert("Lỗi in đơn: " + err.message);
    } finally {
        loader.remove();
    }
}


async function printDirectly(billcode) {
    if (_useSocketPrint) {
        return printViaSocket([billcode]);
    }

    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    const apiUrl = isMobile ? '/api/print-orders-multi-mobile' : '/api/print-orders-multi';
    const orderCodes = [billcode];

    const loader = document.createElement('div');
    loader.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;color:white;z-index:9999;font-family:sans-serif;';
    loader.innerHTML = 'Đang tạo bản in...';
    document.body.appendChild(loader);

    try {
        await new Promise(r => setTimeout(r, 100));

        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: orderCodes }) 
        });

        if (response.status === 404) {
             alert("Hệ thống chưa xử lý xong đơn hàng, vui lòng đợi 2 giây rồi bấm lại!");
             return;
        }
        if (!response.ok) {
            throw new Error("Lỗi phản hồi từ máy chủ");
        }

        if (isMobile) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            
            const newWindow = window.open(url, '_blank');
            if (!newWindow) {
                const link = document.createElement('a');
                link.href = url;
                link.target = '_blank';
                link.download = `don-hang-${billcode}.pdf`;
                link.click();
            }
            
            setTimeout(() => window.URL.revokeObjectURL(url), 5000);
        } else {
            const html = await response.text();

            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            document.body.appendChild(iframe);

            const closeHandler = function(e) {
                if (e.data === 'close-print-frame') {
                    document.body.removeChild(iframe);
                    window.removeEventListener('message', closeHandler);
                }
            };
            window.addEventListener('message', closeHandler);

            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(html);
            doc.close();
        }

        await markOrdersPrinted([billcode]);

    } catch (err) {
        console.error("Lỗi in đơn:", err);
        alert("Có lỗi xảy ra khi tạo bản in. Vui lòng thử lại!");
    } finally {
        if (loader && loader.parentNode) {
            loader.remove();
        }
    }
}

async function markOrdersPrinted(orderCodes) {
    if (!orderCodes || orderCodes.length === 0) return;
    try {
        await fetch('/api/orders/mark-printed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: orderCodes })
        });
        document.querySelectorAll('.order-checkbox').forEach(cb => {
            try {
                const data = JSON.parse(cb.getAttribute('data-order'));
                if (orderCodes.includes(data.order_code)) {
                    const row = cb.closest('tr') || cb.closest('.order-card');
                    if (row) {
                        row.querySelectorAll('.fa-print').forEach(icon => {
                            if (!icon.closest('button') && !icon.closest('.btn')) {
                                icon.classList.remove('text-danger');
                                icon.classList.add('text-success');
                                icon.title = 'Đã in - ' + new Date().toLocaleString('vi-VN');
                            }
                        });
                    }
                }
            } catch(e) {}
        });
    } catch(err) {
        console.warn('[mark-printed] Lỗi:', err.message);
    }
}

