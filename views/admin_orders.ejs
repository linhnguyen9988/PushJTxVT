        <script>
            const DB_BASE_PRICE = Number("<%= stats.base_price %>") || 0;
            const DB_STEP_PRICE = Number("<%= stats.step_price %>") || 0;
            const DB_BASE_WEIGHT = Number("<%= stats.base_weight %>") || 0;
            const CURRENT_ROLE = "<%= currentRole %>";
            function showCustTagWarning(tag) {
                const box = document.getElementById('cust-tag-warning');
                const label = document.getElementById('cust-tag-warning-label');
                if (!box || !label) return;
                if (tag === 'bom_hang') {
                    label.textContent = 'Bom hàng';
                    box.classList.remove('d-none');
                } else if (tag === 'xa_hang') {
                    label.textContent = 'Xả hàng';
                    box.classList.remove('d-none');
                } else {
                    box.classList.add('d-none');
                }
            }

            function showPopup() {
                showCustTagWarning(null);
                document.getElementById('custom-popup-overlay').style.display = 'block';

                const scrollY = window.pageYOffset;
                document.documentElement.style.overflow = 'hidden';
                document.body.style.overflow = 'hidden';
                document.body.style.position = 'fixed';
                document.body.style.top = `-${scrollY}px`;
                document.body.style.width = '100%';
            }

            function hidePopup() {
                const scrollY = document.body.style.top;
                document.getElementById('custom-popup-overlay').style.display = 'none';

                document.documentElement.style.overflow = '';
                document.body.style.overflow = '';
                document.body.style.position = '';
                document.body.style.top = '';
                document.body.style.width = '';

                window.scrollTo(0, parseInt(scrollY || '0') * -1);
            }
            function updatePreviewFee() {
    const codInput = document.getElementById('pop_cod');
    const weightInput = document.getElementById('pop_weight');

    const cod = Number(codInput.value.toString().replace(/\D/g, '')) || 0;
    const weight = parseFloat(weightInput.value) || 0;

    if (DB_BASE_PRICE === 0) {
        document.getElementById('pop_fee_text').innerText = "Chưa cấu hình giá";
        return;
    }

    let fee = DB_BASE_PRICE;

    if (weight > DB_BASE_WEIGHT && DB_STEP_PRICE > 0) {
        const extraWeight = weight - DB_BASE_WEIGHT;
        const billableExtra = Math.ceil(extraWeight);
        
        fee += billableExtra * DB_STEP_PRICE;
    }

    const received = cod - fee;

    document.getElementById('pop_fee_text').innerText = Math.floor(fee).toLocaleString('vi-VN') + "đ";
    document.getElementById('pop_received_text').innerText = Math.floor(received).toLocaleString('vi-VN') + "đ";

    const receivedDisplay = document.getElementById('pop_received_text');
    receivedDisplay.style.color = received < 0 ? 'red' : '#198754';
    
}

