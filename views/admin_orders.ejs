        <style>
            /* Tag search box */
            .tag-search-box {
                cursor: text;
            }
            .tag-search-box::-webkit-scrollbar {
                display: none;
            }
            .tag-search-box {
                background: #fff;
                transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
            }
            .tag-search-box:focus-within {
                border-color: #86b7fe;
                box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
            }
            .tag-typing-input {
                border: none !important;
                outline: none !important;
                background: transparent;
                box-shadow: none !important;
                min-width: 80px;
                flex: 1;
            }
            .search-tag {
                animation: tagPop .15s ease;
            }
            @keyframes tagPop {
                from { transform: scale(0.7); opacity: 0; }
                to   { transform: scale(1);   opacity: 1; }
            }
            /* Mobile filter drawer */
            .filter-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 1040;
            }
            .filter-overlay.show {
                display: block;
            }
            .filter-drawer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                max-height: 90vh;
                overflow-y: auto;
                background: #fff;
                border-radius: 16px 16px 0 0;
                z-index: 1050;
                transform: translateY(100%);
                transition: transform 0.3s ease;
            }
            .filter-drawer.show {
                transform: translateY(0);
            }
            @page { 
                size: ${pageSize}; 
                margin: 0 !important; 
            }
            html, body { 
                margin: 0 !important; 
                padding: 0 !important; 
                width: 100%;
                height: 100%;
                overflow: hidden;
                background: #fff;
            }
            .page-container {
                width: 100%;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                page-break-after: always;
                overflow: hidden;
            }
            img { 
                /* Trừ hao 2% để không bao giờ bị chạm mép gây nhảy trang */
                max-width: 98%; 
                max-height: 98%;
                object-fit: contain;
                display: block;
            }
        </style>
    </head>
    <body>
        ${finalOrdersToPrint.map((_, index) => {
            return `<div class="page-container">${imagesHtml.split('style="width:100%; display:block; page-break-after:always;">')[index]}</div>`;
        }).join('')}
        
        <script>
            async function waitImagesAndPrint() {
                const imgs = Array.from(document.querySelectorAll('img'));
                const promises = imgs.map(img => {
                    return new Promise((resolve) => {
                        if (img.complete) resolve();
                        else { img.onload = resolve; img.onerror = resolve; }
                    });
                });
                await Promise.all(promises);
                setTimeout(() => {
                    window.print();
                    window.isPrintCalled = true;
                }, 800);
            }
            window.onload = waitImagesAndPrint;
            window.onafterprint = function() { window.close(); };
            window.onfocus = function() {
                if (window.isPrintCalled) {
                    setTimeout(function() { window.close(); }, 500);
                }
            };
        <\/script>
    </body>
</html>`;

            if (isAndroid) {
