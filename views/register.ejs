<%- include('partials/header', { authArtwork: true }) %>

<main class="auth-scene" aria-label="Đăng ký tài khoản">
    <div class="auth-panel">
        <div class="card auth-panel-card">
            <span class="ui-page-kicker text-center mb-2">Bắt đầu với TV Ship</span>
            <h3 class="text-center fw-bold mb-1">Đăng ký tài khoản</h3>
            <p class="text-center text-muted small mb-4">Tạo tài khoản shop để bắt đầu tạo vận đơn</p>

            <% if(error_msg != '') { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof registrationLocked !== 'undefined' && registrationLocked) { %>
                <div class="alert alert-warning">
                    <i class="fas fa-lock me-1"></i>
                    Đăng ký tài khoản mới hiện đang tạm khóa. Vui lòng liên hệ quản trị viên.
                </div>
            <% } %>

            <form action="/register" method="POST">
                <fieldset <%= (typeof registrationLocked !== 'undefined' && registrationLocked) ? 'disabled' : '' %>>
                <div class="mb-3">
                    <label for="auth-username" class="form-label">Số điện thoại</label>
                    <input id="auth-username" autocomplete="username" type="text" name="username" class="form-control"
                           placeholder="Nhập tên đăng nhập (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <div class="mb-3">
                    <label for="auth-shopname" class="form-label">Tên shop</label>
                    <input id="auth-shopname" autocomplete="organization" type="text" name="shopname" class="form-control"
                           placeholder="Nhập tên shop (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <div class="mb-3">
                    <label for="auth-password" class="form-label">Mật khẩu</label>
                    <input id="auth-password" autocomplete="new-password" type="password" name="password" class="form-control"
                           placeholder="Nhập mật khẩu (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Tạo tài khoản</button>
                </fieldset>
            </form>
            <div class="text-center mt-4">
                <p class="mb-0 text-muted small">Đã có tài khoản? <a href="/login" class="text-decoration-none fw-bold">Đăng nhập</a></p>
            </div>
        </div>
    </div>
</main>



<%- include('partials/footer', { active: 'orders' }) %>
