<%- include('partials/header') %>

<div class="auth-wrap d-flex align-items-center justify-content-center">
    <div class="col-11 col-sm-9 col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <img src="/logo.png" alt="TV Ship" style="height: 48px;">
        </div>
        <div class="card border-0 shadow-lg p-4 p-md-5">
            <h3 class="text-center fw-bold mb-1">Đăng ký tài khoản</h3>
            <p class="text-center text-muted small mb-4">Tạo tài khoản shop để bắt đầu tạo vận đơn</p>

            <% if(error_msg != '') { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" name="username" class="form-control"
                           placeholder="Nhập tên đăng nhập (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tên shop</label>
                    <input type="text" name="shopname" class="form-control"
                           placeholder="Nhập tên shop (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" name="password" class="form-control"
                           placeholder="Nhập mật khẩu (>= 4 ký tự)"
                           minlength="4" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Tạo tài khoản</button>
            </form>
            <div class="text-center mt-4">
                <p class="mb-0 text-muted small">Đã có tài khoản? <a href="/login" class="text-decoration-none fw-bold">Đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>

<style>
.auth-wrap { min-height: calc(100vh - 90px); padding: 24px 0; }
</style>

<%- include('partials/footer', { active: 'orders' }) %>
