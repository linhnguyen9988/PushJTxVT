                <div class="bg-white p-4 rounded shadow-lg text-start" style="min-width: 320px; max-width: 400px; width: 90%;">
                    <h5 class="fw-bold mb-3"><i class="fas fa-key me-2 text-secondary"></i>Tạo lại mã khôi phục</h5>
                    <p class="small text-muted mb-2">
                        Các mã khôi phục cũ sẽ <strong>không còn hiệu lực</strong>. Nhập mã 6 số từ app Authenticator
                        (hoặc 1 mã khôi phục còn lại) để xác nhận.
                    </p>
                    <div id="regen-recovery-code" class="mb-3"></div>
                    <div id="regen-recovery-error" class="alert alert-danger py-1 px-2 small mb-3" style="display:none;"></div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light flex-grow-1" onclick="closeRegenRecoveryModal()">Hủy</button>
                        <button class="btn btn-secondary flex-grow-1" id="regen-recovery-btn" onclick="confirmRegenRecovery()">Xác nhận</button>
                    </div>
                </div>
            </div>

            <div id="recovery-codes-modal-overlay" class="custom-popup-overlay"
                style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:10001; justify-content:center; align-items:center;">
                <div class="bg-white p-4 rounded shadow-lg text-start" style="min-width: 320px; max-width: 440px; width: 92%;">
                    <h5 class="fw-bold mb-2"><i class="fas fa-key me-2 text-warning"></i>Mã khôi phục 2FA</h5>
                    <p class="small text-muted mb-3">
                        Lưu lại 8 mã này ở nơi an toàn. Mỗi mã chỉ dùng được <strong>1 lần</strong> để đăng nhập / đổi mật khẩu /
                        tắt 2FA khi bạn <strong>mất thiết bị Authenticator</strong>. Mã sẽ <strong>không hiển thị lại</strong> sau khi đóng cửa sổ này.
                    </p>
                    <div id="recovery-codes-list" class="mb-3 p-3" style="background:#f8f9fa;border-radius:8px;font-family:monospace;font-size:0.95rem;line-height:1.9;text-align:center;"></div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="copyRecoveryCodes()"><i class="fas fa-copy me-1"></i>Sao chép</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="downloadRecoveryCodes()"><i class="fas fa-download me-1"></i>Tải xuống</button>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="recovery-saved-check">
                        <label class="form-check-label small" for="recovery-saved-check">Tôi đã lưu lại các mã này ở nơi an toàn.</label>
                    </div>
                    <button type="button" class="btn btn-primary w-100" id="recovery-codes-close-btn" disabled onclick="closeRecoveryCodesModal()">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script>

        function openProductModal() {
            document.getElementById('product-content').value = '';
            document.getElementById('product-modal-overlay').style.display = 'flex';
        }

        function closeProductModal() {
            document.getElementById('product-modal-overlay').style.display = 'none';
        }

        function openNoteModal() {
            document.getElementById('note-content').value = '';
            document.getElementById('note-modal-overlay').style.display = 'flex';
        }

        function closeNoteModal() {
            document.getElementById('note-modal-overlay').style.display = 'none';
        }

        async function saveNote() {
            const content = document.getElementById('note-content').value;
            if (!content) return alert("Vui lòng nhập nội dung!");

            try {
                const res = await fetch('/api/profile/notes/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content })
                });
                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || "Lỗi khi lưu");
                }
            } catch (e) {
                console.error(e);
                alert("Lỗi kết nối server!");
            }
        }

        async function deleteNote(id) {
            if (!confirm("Xóa ghi chú này?")) return;
            try {
                const res = await fetch(`/api/profile/notes/delete/${id}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    const row = document.getElementById(`note-row-${id}`);
                    if (row) row.remove();
                }
            } catch (e) {
                alert("Lỗi xóa ghi chú!");
            }
        }

        async function saveProduct() {
            const content = document.getElementById('product-content').value;
            if (!content) return alert("Vui lòng nhập nội dung!");

            try {
                const res = await fetch('/api/profile/products/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content })
                });
                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || "Lỗi khi lưu");
                }
            } catch (e) {
                console.error(e);
                alert("Lỗi kết nối server!");
            }
        }

        async function deleteProduct(id) {
            if (!confirm("Xóa mặt hàng này?")) return;
            try {
                const res = await fetch(`/api/profile/products/delete/${id}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    const row = document.getElementById(`product-row-${id}`);
                    if (row) row.remove();
                }
            } catch (e) {
                alert("Lỗi xóa mặt hàng!");
            }
        }

        async function toggleSocketPrintSetting(enabled) {
            const msgEl = document.getElementById('socket-print-toggle-msg');
            msgEl.style.display = 'none';
            try {
                const res = await fetch('/api/profile/toggle-socket-print', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ use_socket_print: enabled ? 1 : 0 })
                });
                const data = await res.json();
                msgEl.style.display = 'block';
                if (data.success) {
                    msgEl.className = 'mt-2 small text-success';
                    msgEl.textContent = enabled ? '✓ Đã bật in qua App C# mặc định' : '✓ Đã tắt, sẽ xuất PDF như bình thường';
                } else {
                    msgEl.className = 'mt-2 small text-danger';
                    msgEl.textContent = 'Lỗi: ' + (data.message || 'Không thể lưu cài đặt');
                    document.getElementById('toggleSocketPrintSwitch').checked = !enabled;
                }
                setTimeout(() => { msgEl.style.display = 'none'; }, 2500);
            } catch (e) {
                msgEl.style.display = 'block';
                msgEl.className = 'mt-2 small text-danger';
                msgEl.textContent = 'Lỗi kết nối';
                document.getElementById('toggleSocketPrintSwitch').checked = !enabled;
            }
        }

        async function toggleCodSetting(enabled) {
            const msgEl = document.getElementById('cod-toggle-msg');
            msgEl.style.display = 'none';
            try {
                const res = await fetch('/api/profile/toggle-cod', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ show_cod: enabled ? 1 : 0 })
                });
                const data = await res.json();
                msgEl.style.display = 'block';
                if (data.success) {
                    msgEl.className = 'mt-2 small text-success';
                    msgEl.textContent = enabled ? '✓ Đã bật hiển thị COD trên tem' : '✓ Đã tắt hiển thị COD trên tem';
                } else {
                    msgEl.className = 'mt-2 small text-danger';
                    msgEl.textContent = 'Lỗi: ' + (data.message || 'Không thể lưu cài đặt');
                    document.getElementById('toggleCodSwitch').checked = !enabled;
                }
                setTimeout(() => { msgEl.style.display = 'none'; }, 2500);
            } catch (e) {
                msgEl.style.display = 'block';
                msgEl.className = 'mt-2 small text-danger';
                msgEl.textContent = 'Lỗi kết nối';
                document.getElementById('toggleCodSwitch').checked = !enabled;
            }
        }

    </script>

    <script>
        const CURRENT_USER_ID = '<%= stats.id %>';

        async function checkPrinterStatus() {
            const badge = document.getElementById('printer-status-badge');
            const btn = document.getElementById('btn-check-printer');
            btn.disabled = true;
            badge.className = 'badge bg-secondary';
            badge.innerHTML = '<i class="fas fa-spinner fa-spin me-1" style="font-size:0.6rem;"></i>Đang kiểm tra...';
            try {
                const res = await fetch('/api/printer-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: CURRENT_USER_ID })
                });
                const data = await res.json();
                if (data.online) {
                    badge.className = 'badge bg-success';
                    badge.innerHTML = '<i class="fas fa-circle me-1" style="font-size:0.6rem;"></i>App C# đang Online';
                } else {
                    badge.className = 'badge bg-danger';
                    badge.innerHTML = '<i class="fas fa-circle me-1" style="font-size:0.6rem;"></i>App C# Offline';
                }
            } catch (e) {
                badge.className = 'badge bg-warning text-dark';
                badge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Lỗi kết nối';
            }
            btn.disabled = false;
        }

        
    </script>

    <script>
        const fmt = n => Number(n || 0).toLocaleString('vi-VN') + 'đ';

        const statsKeys = ['pending', 'picked_up', 'delivering', 'completed', 'returned', 'issue', 'cancel'];

        function setStats(s) {
            document.getElementById('s-total').innerText = Number(s.total || 0).toLocaleString('vi-VN') + ' đơn';
            statsKeys.forEach(k => {
                document.getElementById('s-cnt-' + k).innerText = Number(s['cnt_' + k] || 0).toLocaleString('vi-VN');
                document.getElementById('s-rev-' + k).innerText = fmt(s['rev_' + k]);
            });
        }

        function setLoading() {
            document.getElementById('s-total').innerText = '...';
            statsKeys.forEach(k => {
                document.getElementById('s-cnt-' + k).innerText = '...';
                document.getElementById('s-rev-' + k).innerText = '...';
            });
        }

        async function loadStats(days) {
            setLoading();
            try {
                const res = await fetch(`/api/profile/stats?days=${days}`);
                const data = await res.json();
                if (data.success) setStats(data.stats);
            } catch (e) {
                document.getElementById('s-total').innerText = 'Lỗi';
            }
        }

        document.querySelectorAll('.stats-filter').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.stats-filter').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                loadStats(Number(this.dataset.days));
            });
        });

        loadStats(1);
    </script>

    <script>
        (function () {
            var sw = document.getElementById('toggleDarkMode');
            var current = localStorage.getItem('tvship-theme') === 'dark';
            sw.checked = current;

            sw.addEventListener('change', function () {
                if (this.checked) {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                    localStorage.setItem('tvship-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-bs-theme');
                    localStorage.setItem('tvship-theme', 'light');
                }
            });
        })();
    </script>

    <script>
        const cpOtpHost = document.getElementById('cp-totp');
        const cpOtp = cpOtpHost ? OtpInput.mount(cpOtpHost, {
            recovery: true, size: 'sm',
            onSubmit: (value, info) => {
                const filled = ['cp-old', 'cp-new', 'cp-confirm'].every(id => document.getElementById(id).value);
                if (info.auto && !filled) return;
                submitChangePassword();
            }
        }) : null;
        const setupOtp = OtpInput.mount(document.getElementById('tfa-confirm-code'), {
            size: 'sm', onSubmit: () => confirmEnable2FA()
        });
        const disableOtp = OtpInput.mount(document.getElementById('disable-tfa-code'), {
            recovery: true, size: 'sm', onSubmit: () => confirmDisable2FA()
        });
        const regenOtp = OtpInput.mount(document.getElementById('regen-recovery-code'), {
            recovery: true, size: 'sm', onSubmit: () => confirmRegenRecovery()
        });

        function openChangePasswordModal() {
            document.getElementById('cp-old').value = '';
            document.getElementById('cp-new').value = '';
            document.getElementById('cp-confirm').value = '';
            document.getElementById('cp-error').style.display = 'none';
            document.getElementById('change-password-modal-overlay').style.display = 'flex';
            if (cpOtp) cpOtp.reset({ noFocus: true });
        }
        function closeChangePasswordModal() {
            document.getElementById('change-password-modal-overlay').style.display = 'none';
        }

        async function submitChangePassword() {
            const oldPassword = document.getElementById('cp-old').value;
            const newPassword = document.getElementById('cp-new').value;
            const confirmPassword = document.getElementById('cp-confirm').value;
            const totpCode = cpOtp ? cpOtp.getValue().trim() : undefined;
            const errEl = document.getElementById('cp-error');
            errEl.style.display = 'none';

            if (!oldPassword || !newPassword || !confirmPassword) {
                errEl.textContent = 'Vui lòng nhập đầy đủ thông tin.'; errEl.style.display = 'block'; return;
            }
            if (newPassword !== confirmPassword) {
                errEl.textContent = 'Mật khẩu mới không khớp.'; errEl.style.display = 'block'; return;
            }
            if (cpOtp && !cpOtp.isComplete()) {
                errEl.textContent = 'Vui lòng nhập đủ mã 2FA.'; errEl.style.display = 'block'; return;
            }

            const btn = document.getElementById('cp-submit-btn');
            btn.disabled = true; if (cpOtp) cpOtp.setDisabled(true); const origHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang lưu...';
            try {
                const res = await fetch('/api/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword, newPassword, confirmPassword, totpCode })
                });
                const data = await res.json();
                if (data.success) {
                    closeChangePasswordModal();
                    showNotice('Thành công', data.message || 'Đổi mật khẩu thành công.', 'success');
                } else {
                    errEl.textContent = data.message || 'Không thể đổi mật khẩu.'; errEl.style.display = 'block'; if (cpOtp) cpOtp.reset({ keepMode: true, error: true });
                }
            } catch (e) {
                errEl.textContent = 'Lỗi kết nối server.'; errEl.style.display = 'block'; if (cpOtp) cpOtp.reset({ keepMode: true, error: true });
            } finally {
                btn.disabled = false; btn.innerHTML = origHtml; if (cpOtp) cpOtp.setDisabled(false);
            }
        }

        async function openSetup2FAModal() {
            document.getElementById('setup-2fa-modal-overlay').style.display = 'flex';
            document.getElementById('tfa-setup-loading').style.display = 'block';
            document.getElementById('tfa-setup-body').style.display = 'none';
            document.getElementById('tfa-setup-error').style.display = 'none';
            setupOtp.reset({ noFocus: true });

            try {
                const res = await fetch('/api/2fa/setup', { method: 'POST' });
                const data = await res.json();
                if (!data.success) {
                    closeSetup2FAModal();
                    showNotice('Lỗi', data.message || 'Không thể tạo mã 2FA.', 'error');
                    return;
                }
                document.getElementById('tfa-qr-img').src = data.qrDataUrl;
                document.getElementById('tfa-secret-text').value = data.secret;
                document.getElementById('tfa-setup-loading').style.display = 'none';
                document.getElementById('tfa-setup-body').style.display = 'block';
                setupOtp.reset({ noFocus: true });
            } catch (e) {
                closeSetup2FAModal();
                showNotice('Lỗi', 'Lỗi kết nối server.', 'error');
            }
        }
        function closeSetup2FAModal() {
            document.getElementById('setup-2fa-modal-overlay').style.display = 'none';
        }
        function copyTfaSecret() {
            const el = document.getElementById('tfa-secret-text');
            el.select(); el.setSelectionRange(0, 99999);
            try { document.execCommand('copy'); } catch (e) {}
            if (navigator.clipboard) navigator.clipboard.writeText(el.value).catch(() => {});
        }
        async function confirmEnable2FA() {
            const code = setupOtp.getValue();
            const errEl = document.getElementById('tfa-setup-error');
            errEl.style.display = 'none';
            if (!setupOtp.isComplete()) {
                errEl.textContent = 'Vui lòng nhập đủ mã 6 số.'; errEl.style.display = 'block'; return;
            }
            const btn = document.getElementById('tfa-enable-btn');
            btn.disabled = true; setupOtp.setDisabled(true); const orig = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xác nhận...';
            try {
                const res = await fetch('/api/2fa/enable', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await res.json();
                if (data.success) {
                    closeSetup2FAModal();
                    showRecoveryCodesModal(data.recoveryCodes || []);
                    window.needsReload = true;
                } else {
                    errEl.textContent = data.message || 'Mã không đúng.'; errEl.style.display = 'block'; setupOtp.reset({ keepMode: true, error: true });
                }
            } catch (e) {
                errEl.textContent = 'Lỗi kết nối server.'; errEl.style.display = 'block'; setupOtp.reset({ keepMode: true, error: true });
            } finally {
                btn.disabled = false; btn.innerHTML = orig; setupOtp.setDisabled(false);
            }
        }

        function openDisable2FAModal() {
            document.getElementById('tfa-disable-error').style.display = 'none';
            document.getElementById('disable-2fa-modal-overlay').style.display = 'flex';
            disableOtp.reset();
        }
        function closeDisable2FAModal() {
            document.getElementById('disable-2fa-modal-overlay').style.display = 'none';
        }
        async function confirmDisable2FA() {
            const code = disableOtp.getValue();
            const errEl = document.getElementById('tfa-disable-error');
            errEl.style.display = 'none';
            if (!disableOtp.isComplete()) { errEl.textContent = 'Vui lòng nhập mã 2FA.'; errEl.style.display = 'block'; return; }

            const btn = document.getElementById('tfa-disable-btn');
            btn.disabled = true; disableOtp.setDisabled(true); const orig = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';
            try {
                const res = await fetch('/api/2fa/disable', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await res.json();
                if (data.success) {
                    closeDisable2FAModal();
                    showNotice('Thành công', data.message || 'Đã tắt 2FA.', 'success');
                    window.needsReload = true;
                } else {
                    errEl.textContent = data.message || 'Mã không đúng.'; errEl.style.display = 'block'; disableOtp.reset({ keepMode: true, error: true });
                }
            } catch (e) {
                errEl.textContent = 'Lỗi kết nối server.'; errEl.style.display = 'block'; disableOtp.reset({ keepMode: true, error: true });
            } finally {
                btn.disabled = false; btn.innerHTML = orig; disableOtp.setDisabled(false);
            }
        }

        function openRegenRecoveryModal() {
            document.getElementById('regen-recovery-error').style.display = 'none';
            document.getElementById('regen-recovery-modal-overlay').style.display = 'flex';
            regenOtp.reset();
        }
        function closeRegenRecoveryModal() {
            document.getElementById('regen-recovery-modal-overlay').style.display = 'none';
        }
        async function confirmRegenRecovery() {
            const code = regenOtp.getValue();
            const errEl = document.getElementById('regen-recovery-error');
            errEl.style.display = 'none';
            if (!regenOtp.isComplete()) { errEl.textContent = 'Vui lòng nhập mã xác nhận.'; errEl.style.display = 'block'; return; }

            const btn = document.getElementById('regen-recovery-btn');
            btn.disabled = true; regenOtp.setDisabled(true); const orig = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';
            try {
                const res = await fetch('/api/2fa/recovery-codes/regenerate', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });
                const data = await res.json();
                if (data.success) {
                    closeRegenRecoveryModal();
                    showRecoveryCodesModal(data.recoveryCodes || []);
                } else {
                    errEl.textContent = data.message || 'Mã không đúng.'; errEl.style.display = 'block'; regenOtp.reset({ keepMode: true, error: true });
                }
            } catch (e) {
                errEl.textContent = 'Lỗi kết nối server.'; errEl.style.display = 'block'; regenOtp.reset({ keepMode: true, error: true });
            } finally {
                btn.disabled = false; btn.innerHTML = orig; regenOtp.setDisabled(false);
            }
        }

        let _currentRecoveryCodes = [];
        function showRecoveryCodesModal(codes) {
            _currentRecoveryCodes = codes;
            const listEl = document.getElementById('recovery-codes-list');
            listEl.innerHTML = codes.map(c => `<div>${c}</div>`).join('');
            document.getElementById('recovery-saved-check').checked = false;
            document.getElementById('recovery-codes-close-btn').disabled = true;
            document.getElementById('recovery-codes-modal-overlay').style.display = 'flex';
        }
        function closeRecoveryCodesModal() {
            document.getElementById('recovery-codes-modal-overlay').style.display = 'none';
            if (window.needsReload) { window.needsReload = false; location.reload(); }
        }
        document.getElementById('recovery-saved-check').addEventListener('change', function () {
            document.getElementById('recovery-codes-close-btn').disabled = !this.checked;
        });
        function copyRecoveryCodes() {
            const text = _currentRecoveryCodes.join('\n');
            if (navigator.clipboard) navigator.clipboard.writeText(text).catch(() => {});
            showNotice('Đã sao chép', 'Đã sao chép các mã khôi phục vào clipboard.', 'success');
        }
        function downloadRecoveryCodes() {
            const text = 'TV Ship - Mã khôi phục 2FA\nMỗi mã chỉ dùng được 1 lần.\n\n' + _currentRecoveryCodes.join('\n') + '\n';
            const blob = new Blob([text], { type: 'text/plain' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'tvship-2fa-recovery-codes.txt';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
        }
    </script>

